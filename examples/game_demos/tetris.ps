# ═══════════════════════════════════════════════════════════════════════════════
# Tetris — examples/game_demos/tetris.ps
#
# Simple Tetris clone written in Pasta v0.01a.
# Uses a memory-backed 10x20 board, grid drawing, and keyboard controls.
#
# Controls:  Left / A    — move piece left
#            Right / D   — move piece right
#            Up / W / X  — rotate piece
#            Down / S    — soft drop
#            Space       — pause / resume
#            Escape      — quit
#            Enter       — restart after game over
#
# Run:  cargo run --features x11 -- examples/game_demos/tetris.ps
# ═══════════════════════════════════════════════════════════════════════════════

# ── Board / window constants ───────────────────────────────────────────────────
COLS         = 10
ROWS         = 20
CELL         = 22
BOARD_W      = COLS * CELL
BOARD_H      = ROWS * CELL
PANEL_W      = 170
WIN_W        = BOARD_W + PANEL_W
WIN_H        = BOARD_H
FPS          = 60
DROP_BASE    = 28
DROP_MIN     = 8
SCORE_TO_BAR = 100
LINES_STEP   = 5

# ── Colors ────────────────────────────────────────────────────────────────────
COL_BG       = color(12, 14, 22)
COL_BOARD    = color(18, 20, 30)
COL_GRID     = color(34, 38, 54)
COL_PANEL    = color(22, 26, 38)
COL_PAUSE    = color(255, 210, 90)
COL_GAMEOVER = color(255, 120, 120)
COL_I        = color(90, 220, 255)
COL_O        = color(255, 220, 90)
COL_T        = color(200, 120, 255)
COL_S        = color(110, 230, 130)
COL_Z        = color(255, 110, 110)
COL_J        = color(90, 140, 255)
COL_L        = color(255, 170, 80)

# ── Board storage ──────────────────────────────────────────────────────────────
BOARD_CELLS = COLS * ROWS
ALLOC.MEM(BOARD_CELLS) -> board

# ── Utility helpers ────────────────────────────────────────────────────────────
DEF fill_box_to(target, x, y, w, h, color_value):
    SET_COLOR(color_value)
    canvas_fill_rect(target, x, y, x + w, y + h)
END

DEF clamp(v, low, high):
    IF v < low:
        RET.NOW(): low
    END
    IF v > high:
        RET.NOW(): high
    END
    RET.NOW(): v
END

DEF board_idx(x, y):
    RET.NOW(): y * COLS + x
END

DEF board_get(x, y):
    RET.NOW(): PEEK(board, board_idx(x, y))
END

DEF board_set(x, y, value):
    POKE(board, board_idx(x, y), value)
END

DEF clear_board():
    i = 0
    WHILE i < BOARD_CELLS:
        POKE(board, i, 0)
        i = i + 1
    END
END

DEF fill_box(x, y, w, h, color_value):
    fill_box_to(win, x, y, w, h, color_value)
END

DEF next_rot(rot):
    r = rot + 1
    IF r >= 4:
        r = 0
    END
    RET.NOW(): r
END

DEF piece_color(piece_id):
    IF piece_id == 0:
        RET.NOW(): COL_I
    END
    IF piece_id == 1:
        RET.NOW(): COL_O
    END
    IF piece_id == 2:
        RET.NOW(): COL_T
    END
    IF piece_id == 3:
        RET.NOW(): COL_S
    END
    IF piece_id == 4:
        RET.NOW(): COL_Z
    END
    IF piece_id == 5:
        RET.NOW(): COL_J
    END
    RET.NOW(): COL_L
END

DEF piece_cells(piece_id, rot):
    IF piece_id == 0:
        IF rot == 0 OR rot == 2:
            RET.NOW(): [[0, 1], [1, 1], [2, 1], [3, 1]]
        END
        RET.NOW(): [[2, 0], [2, 1], [2, 2], [2, 3]]
    END

    IF piece_id == 1:
        RET.NOW(): [[1, 0], [2, 0], [1, 1], [2, 1]]
    END

    IF piece_id == 2:
        IF rot == 0:
            RET.NOW(): [[1, 0], [0, 1], [1, 1], [2, 1]]
        END
        IF rot == 1:
            RET.NOW(): [[1, 0], [1, 1], [2, 1], [1, 2]]
        END
        IF rot == 2:
            RET.NOW(): [[0, 1], [1, 1], [2, 1], [1, 2]]
        END
        RET.NOW(): [[1, 0], [0, 1], [1, 1], [1, 2]]
    END

    IF piece_id == 3:
        IF rot == 0 OR rot == 2:
            RET.NOW(): [[1, 0], [2, 0], [0, 1], [1, 1]]
        END
        RET.NOW(): [[1, 0], [1, 1], [2, 1], [2, 2]]
    END

    IF piece_id == 4:
        IF rot == 0 OR rot == 2:
            RET.NOW(): [[0, 0], [1, 0], [1, 1], [2, 1]]
        END
        RET.NOW(): [[2, 0], [1, 1], [2, 1], [1, 2]]
    END

    IF piece_id == 5:
        IF rot == 0:
            RET.NOW(): [[0, 0], [0, 1], [1, 1], [2, 1]]
        END
        IF rot == 1:
            RET.NOW(): [[1, 0], [2, 0], [1, 1], [1, 2]]
        END
        IF rot == 2:
            RET.NOW(): [[0, 1], [1, 1], [2, 1], [2, 2]]
        END
        RET.NOW(): [[1, 0], [1, 1], [0, 2], [1, 2]]
    END

    IF rot == 0:
        RET.NOW(): [[2, 0], [0, 1], [1, 1], [2, 1]]
    END
    IF rot == 1:
        RET.NOW(): [[1, 0], [1, 1], [1, 2], [2, 2]]
    END
    IF rot == 2:
        RET.NOW(): [[0, 1], [1, 1], [2, 1], [0, 2]]
    END
    RET.NOW(): [[0, 0], [1, 0], [1, 1], [1, 2]]
END

DEF can_place(piece_id, rot, px, py):
    cells = piece_cells(piece_id, rot)
    ok = true
    i = 0
    WHILE i < 4 AND ok:
        x = px + cells[i][0]
        y = py + cells[i][1]
        IF x < 0 OR x >= COLS OR y < 0 OR y >= ROWS:
            ok = false
        OTHERWISE:
            IF board_get(x, y) != 0:
                ok = false
            END
        END
        i = i + 1
    END
    RET.NOW(): ok
END

DEF lock_piece(piece_id, rot, px, py):
    value = piece_id + 1
    cells = piece_cells(piece_id, rot)
    i = 0
    WHILE i < 4:
        x = px + cells[i][0]
        y = py + cells[i][1]
        board_set(x, y, value)
        i = i + 1
    END
END

DEF shift_rows_down(from_row):
    y = from_row
    WHILE y > 0:
        x = 0
        WHILE x < COLS:
            board_set(x, y, board_get(x, y - 1))
            x = x + 1
        END
        y = y - 1
    END

    x = 0
    WHILE x < COLS:
        board_set(x, 0, 0)
        x = x + 1
    END
END

DEF clear_lines():
    y = ROWS - 1
    cleared = 0
    WHILE y >= 0:
        full = true
        x = 0
        WHILE x < COLS AND full:
            IF board_get(x, y) == 0:
                full = false
            END
            x = x + 1
        END

        IF full:
            shift_rows_down(y)
            cleared = cleared + 1
        OTHERWISE:
            y = y - 1
        END
    END
    RET.NOW(): cleared
END

DEF blocks_for(total, block_size, max_blocks):
    count = 0
    remain = total
    WHILE remain >= block_size AND count < max_blocks:
        remain = remain - block_size
        count = count + 1
    END
    RET.NOW(): count
END

DEF draw_meter(base_x, base_y, blocks, color_value):
    i = 0
    WHILE i < blocks:
        fill_box(base_x, base_y + i * 14, 16, 10, color_value)
        i = i + 1
    END
END

DEF draw_static_background():
    fill_box_to(bg, 0, 0, WIN_W, WIN_H, COL_BG)
    fill_box_to(bg, 0, 0, BOARD_W, BOARD_H, COL_BOARD)
    fill_box_to(bg, BOARD_W, 0, PANEL_W, WIN_H, COL_PANEL)

    SET_COLOR(COL_GRID)
    x = 0
    WHILE x <= COLS:
        px_line = x * CELL
        canvas_fill_rect(bg, px_line, 0, px_line + 1, BOARD_H)
        x = x + 1
    END

    y = 0
    WHILE y <= ROWS:
        py_line = y * CELL
        canvas_fill_rect(bg, 0, py_line, BOARD_W, py_line + 1)
        y = y + 1
    END

    fill_box_to(bg, BOARD_W + 18, 18, PANEL_W - 36, 2, COL_GRID)
    fill_box_to(bg, BOARD_W + 18, 144, PANEL_W - 36, 2, COL_GRID)
    fill_box_to(bg, BOARD_W + 18, 300, PANEL_W - 36, 2, COL_GRID)
END

DEF draw_preview(piece_id):
    ox = BOARD_W + 52
    oy = 70
    cells = piece_cells(piece_id, 0)
    i = 0
    WHILE i < 4:
        px = ox + cells[i][0] * 18
        py = oy + cells[i][1] * 18
        fill_box(px, py, 16, 16, piece_color(piece_id))
        i = i + 1
    END
END

DEF draw_scene(piece_id, rot, px, py, next_piece, score, lines, level, paused, game_over):
    DRAW_TO_BUFFER(win, bg)

    cells = []

    y = 0
    WHILE y < ROWS:
        x = 0
        WHILE x < COLS:
            cell_value = board_get(x, y)
            IF cell_value != 0:
                list_append(cells, [x, y, piece_color(cell_value - 1)])
            END
            x = x + 1
        END
        y = y + 1
    END

    piece = piece_cells(piece_id, rot)
    i = 0
    WHILE i < 4:
        list_append(cells, [px + piece[i][0], py + piece[i][1], piece_color(piece_id)])
        i = i + 1
    END

    IF list_len(cells) > 0:
        DRAW_GRID_BATCH(cells)
    END

    draw_preview(next_piece)
    draw_meter(BOARD_W + 34, 176, blocks_for(score, SCORE_TO_BAR, 12), COL_O)
    draw_meter(BOARD_W + 78, 176, clamp(lines, 0, 12), COL_S)
    draw_meter(BOARD_W + 122, 176, clamp(level, 0, 12), COL_I)

    IF paused:
        fill_box(BOARD_W + 44, 332, 14, 34, COL_PAUSE)
        fill_box(BOARD_W + 72, 332, 14, 34, COL_PAUSE)
    END

    IF game_over:
        fill_box(BOARD_W + 28, 332, 92, 20, COL_GAMEOVER)
        fill_box(BOARD_W + 44, 360, 60, 12, COL_GAMEOVER)
    END
END

# ── Startup ───────────────────────────────────────────────────────────────────
win = WINDOW("Pasta Tetris", WIN_W, WIN_H)
bg = CANVAS(WIN_W, WIN_H)
SET_DRAW_TARGET(win)
DRAW_GRID(CELL, CELL)
fps_init(FPS)
draw_static_background()

PRINT "Pasta Tetris — Left/Right move, Up rotates, Down drops, Space pauses"

running = true
WHILE running AND window_poll(win):
    clear_board()
    score = 0
    lines = 0
    level = 1
    drop_frames = DROP_BASE
    paused = false
    game_over = false
    frame_counter = 0

    current_kind = rand.int(0, 7)
    next_kind = rand.int(0, 7)
    current_rot = 0
    current_x = 3
    current_y = 0

    IF NOT can_place(current_kind, current_rot, current_x, current_y):
        game_over = true
    END

    PRINT "New Tetris game started"

    WHILE running AND window_poll(win) AND NOT game_over:
        fps_begin(FPS)

        key = WINDOW_KEY(win)
        IF key == "Escape":
            running = false
        END
        IF key == " ":
            IF paused:
                paused = false
            OTHERWISE:
                paused = true
            END
        END

        lock_now = false

        IF NOT paused:
            IF key == "Left" OR key == "a" OR key == "A":
                IF can_place(current_kind, current_rot, current_x - 1, current_y):
                    current_x = current_x - 1
                END
            END

            IF key == "Right" OR key == "d" OR key == "D":
                IF can_place(current_kind, current_rot, current_x + 1, current_y):
                    current_x = current_x + 1
                END
            END

            IF key == "Up" OR key == "w" OR key == "W" OR key == "x" OR key == "X":
                new_rot = next_rot(current_rot)
                IF can_place(current_kind, new_rot, current_x, current_y):
                    current_rot = new_rot
                OTHERWISE:
                    IF can_place(current_kind, new_rot, current_x - 1, current_y):
                        current_x = current_x - 1
                        current_rot = new_rot
                    OTHERWISE:
                        IF can_place(current_kind, new_rot, current_x + 1, current_y):
                            current_x = current_x + 1
                            current_rot = new_rot
                        END
                    END
                END
            END

            IF key == "Down" OR key == "s" OR key == "S":
                IF can_place(current_kind, current_rot, current_x, current_y + 1):
                    current_y = current_y + 1
                    score = score + 1
                OTHERWISE:
                    lock_now = true
                END
            END

            frame_counter = frame_counter + 1
            IF frame_counter >= drop_frames:
                frame_counter = 0
                IF can_place(current_kind, current_rot, current_x, current_y + 1):
                    current_y = current_y + 1
                OTHERWISE:
                    lock_now = true
                END
            END

            IF lock_now:
                lock_piece(current_kind, current_rot, current_x, current_y)
                cleared = clear_lines()

                IF cleared == 1:
                    score = score + 100 * level
                END
                IF cleared == 2:
                    score = score + 300 * level
                END
                IF cleared == 3:
                    score = score + 500 * level
                END
                IF cleared >= 4:
                    score = score + 800 * level
                END

                IF cleared > 0:
                    lines = lines + cleared
                    PRINT "Lines: " + str(lines) + "  Score: " + str(score)
                    IF lines >= level * LINES_STEP:
                        level = level + 1
                        IF drop_frames > DROP_MIN:
                            drop_frames = drop_frames - 3
                            IF drop_frames < DROP_MIN:
                                drop_frames = DROP_MIN
                            END
                        END
                        PRINT "Level up! " + str(level)
                    END
                END

                current_kind = next_kind
                next_kind = rand.int(0, 7)
                current_rot = 0
                current_x = 3
                current_y = 0
                IF NOT can_place(current_kind, current_rot, current_x, current_y):
                    game_over = true
                END
            END
        END

        draw_scene(current_kind, current_rot, current_x, current_y, next_kind, score, lines, level, paused, game_over)
        SWAP_BUFFER(win)
        fps_end()
        fps_tick()
    END

    IF game_over AND running:
        PRINT "Game over — score " + str(score) + ", lines " + str(lines) + ". Press Enter to restart or Escape to quit"
        WHILE running AND window_poll(win):
            fps_begin(FPS)
            draw_scene(current_kind, current_rot, current_x, current_y, next_kind, score, lines, level, true, true)
            SWAP_BUFFER(win)

            key = WINDOW_KEY(win)
            IF key == "Enter":
                BREAK
            END
            IF key == "Escape":
                running = false
                BREAK
            END

            fps_end()
            fps_tick()
        END
    END
END

WINDOW_CLOSE(win)
FREE(board)
PRINT "Pasta Tetris exited."
