# Pasta v0.01a script tests — arithmetic and logic (20 checks)

DEF out_num(label, value):
    PRINT label + ":" + str(value)
END

DEF out_bool(label, value):
    IF value:
        PRINT label + ":true"
    OTHERWISE:
        PRINT label + ":false"
    END
END

out_num("P01T01", 1 + 2)                  # EXPECT: P01T01:3
out_num("P01T02", 7 * 8)                  # EXPECT: P01T02:56
out_num("P01T03", 20 - 3)                 # EXPECT: P01T03:17
out_num("P01T04", 20 / 5)                 # EXPECT: P01T04:4
out_num("P01T05", (2 + 3) * 4)            # EXPECT: P01T05:20
out_num("P01T06", 10 + (3 * 2) - 4)       # EXPECT: P01T06:12
out_num("P01T07", 18 / 3 + 1)             # EXPECT: P01T07:7
out_num("P01T08", 0 - 9)                  # EXPECT: P01T08:-9
out_bool("P01T09", 6 > 4)                 # EXPECT: P01T09:true
out_bool("P01T10", 6 < 4)                 # EXPECT: P01T10:false
out_bool("P01T11", 5 == 5)                # EXPECT: P01T11:true
out_bool("P01T12", 5 != 5)                # EXPECT: P01T12:false
out_bool("P01T13", true AND true)         # EXPECT: P01T13:true
out_bool("P01T14", true AND false)        # EXPECT: P01T14:false
out_bool("P01T15", false OR true)         # EXPECT: P01T15:true
out_bool("P01T16", NOT false)             # EXPECT: P01T16:true
out_bool("P01T17", 3 <= 3)                # EXPECT: P01T17:true
out_bool("P01T18", 4 >= 9)                # EXPECT: P01T18:false
out_num("P01T19", (8 / 2) * (3 + 1))      # EXPECT: P01T19:16
out_num("P01T20", 42 / 7)                 # EXPECT: P01T20:6
