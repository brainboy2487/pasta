# Pasta v0.01a script tests — strings, dicts, regex (20 checks)

DEF out_num(label, value):
    PRINT label + ":" + str(value)
END

DEF out_text(label, value):
    PRINT label + ":" + value
END

DEF out_bool(label, value):
    IF value:
        PRINT label + ":true"
    OTHERWISE:
        PRINT label + ":false"
    END
END

record = {"a": 1, "b": "two"}
dict_set(record, "c", 3)
nested_record = {"items": [4, 5, 6]}

out_text("P05T01", upper("MiXeD"))        # EXPECT: P05T01:MIXED
out_text("P05T02", lower("MiXeD"))        # EXPECT: P05T02:mixed
out_text("P05T03", trim("  hi  "))        # EXPECT: P05T03:hi
out_bool("P05T04", contains("pasta", "ast")) # EXPECT: P05T04:true
out_bool("P05T05", contains("pasta", "zzz")) # EXPECT: P05T05:false
out_text("P05T06", replace.all("a-b-a", "-", ":")) # EXPECT: P05T06:a:b:a
out_num("P05T07", list_len(split("a,b,c", ","))) # EXPECT: P05T07:3
out_text("P05T08", join(["a", "b", "c"], ":")) # EXPECT: P05T08:a:b:c
out_text("P05T09", substr("pasta", 1, 3)) # EXPECT: P05T09:pas
out_bool("P05T10", regex_match("abc123", "[a-z]+[0-9]+")) # EXPECT: P05T10:true
out_bool("P05T11", regex_match("abc", "[0-9]+")) # EXPECT: P05T11:false
out_num("P05T12", dict_get({"a": 1, "b": 2}, "a")) # EXPECT: P05T12:1
out_text("P05T13", dict_get({"a": "one", "b": "two"}, "b")) # EXPECT: P05T13:two
out_num("P05T14", dict_get(record, "c"))  # EXPECT: P05T14:3
out_num("P05T15", dict_len(record))       # EXPECT: P05T15:3
out_num("P05T16", list_len(dict_get(nested_record, "items"))) # EXPECT: P05T16:3
out_num("P05T17", len("abcde"))           # EXPECT: P05T17:5
out_text("P05T18", join(split("red|blue", "|"), ",")) # EXPECT: P05T18:red,blue
out_text("P05T19", replace.all("aaaa", "a", "b")) # EXPECT: P05T19:bbbb
out_text("P05T20", substr("abcdef", 2, 2)) # EXPECT: P05T20:bc
