{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mage vocabulary entry",
  "type": "object",
  "required": ["id","key","type","responses"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "key": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" }, "maxItems": 50 },
    "type": { "type": "string", "enum": ["greeting","farewell","joke","fact","command","info","other"] },
    "responses": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "language": { "type": "string", "minLength": 2 },
    "source": { "type": "string" },
    "license": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
