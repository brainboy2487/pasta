END

DEF builtin_file_write(exe, args):
    IF len(args) != 2: RAISE("file_write expects 2 arguments (path, data)") END
    path_v = args[0]; data_v = args[1]
    IF NOT (type(path_v) == dict and has_key(path_v, "String")): RAISE("file_write: path must be string") END
    path = path_v["String"]
    IF type(data_v) == dict and has_key(data_v, "String"):
        fs_write_file(path, data_v["String"]) ; RETURN({"String": "Wrote {} bytes to {}".format(len(list(data_v["String"])), path)})
    ELIF type(data_v) == list:
        # expect list of numbers (bytes)
        b = []
        FOR it IN data_v:
            IF type(it) in (int, float): b.append(int(round(it)) & 0xFF) ELSE: RAISE("file_write: list must contain numbers") END
        END
        fs_write_bytes(path, b)
        RETURN({"String": "Wrote {} bytes to {}".format(len(b), path)})
    END
    RAISE("file_write: data must be string or list")
END

