END

DEF builtin_tensor_sum(exe, args):
    IF len(args) != 1: RAISE("tensor.sum expects 1 argument") END
    t = args[0]
    IF type(t) == dict and has_key(t, "Tensor"):
        data = t["Tensor"].get("data", [])
        s = 0.0
        FOR v IN data: s = s + float(v) END
        RETURN(float(s))
    END
    RAISE("tensor.sum expects a tensor")
END

DEF builtin_tensor_mean(exe, args):
    IF len(args) != 1: RAISE("tensor.mean expects 1 argument") END
    t = args[0]
    IF type(t) == dict and has_key(t, "Tensor"):
        data = t["Tensor"].get("data", [])
        cnt = len(data)
        IF cnt == 0: RETURN(float(0.0)) END
        s = 0.0
        FOR v IN data: s = s + float(v) END
        RETURN(float(s / cnt))
    END
    RAISE("tensor.mean expects a tensor")
END

DEF builtin_tensor_zeros(exe, args):
    IF len(args) != 1: RAISE("tensor.zeros expects 1 argument (shape)") END
    shape_arg = args[0]
    IF type(shape_arg) == list:
        shape = [int(x) if type(x) in (int,float) else 0 for x in shape_arg]
    ELIF type(shape_arg) in (int, float):
        shape = [int(shape_arg)]
    ELSE:
        RAISE("tensor.zeros: argument must be a list or number")
    END
    numel = 1
    FOR d IN shape: numel = numel * d END
    RETURN({"Tensor": {"shape": shape, "dtype": "float32", "data": [0.0 for _ in range(numel)]}})
END

DEF builtin_tensor_ones(exe, args):
    IF len(args) != 1: RAISE("tensor.ones expects 1 argument (shape)") END
    shape_arg = args[0]
    IF type(shape_arg) == list:
        shape = [int(x) if type(x) in (int,float) else 0 for x in shape_arg]
    ELIF type(shape_arg) in (int, float):
        shape = [int(shape_arg)]
    ELSE:
        RAISE("tensor.ones: argument must be a list or number")
    END
    numel = 1
    FOR d IN shape: numel = numel * d END
    RETURN({"Tensor": {"shape": shape, "dtype": "float32", "data": [1.0 for _ in range(numel)]}})
END

DEF builtin_tensor_reshape(exe, args):
    IF len(args) != 2: RAISE("tensor.reshape expects 2 arguments (tensor, shape)") END
    t = args[0]
    newshape = args[1]
    IF NOT (type(t) == dict and has_key(t, "Tensor")): RAISE("tensor.reshape expects a tensor") END
    IF type(newshape) != list: RAISE("tensor.reshape: shape must be a list") END
    old = t["Tensor"]
    data = old.get("data", [])
    new = [int(x) if type(x) in (int,float) else 0 for x in newshape]
    numel = 1
    FOR d IN new: numel = numel * d END
    IF numel != len(data): RAISE("tensor.reshape: size mismatch") END
    RETURN({"Tensor": {"shape": new, "dtype": old.get("dtype","float32"), "data": data[:]}})
END

DEF builtin_tensor_transpose(exe, args):
    IF len(args) != 1: RAISE("tensor.transpose expects 1 argument") END
    t = args[0]
    IF NOT (type(t) == dict and has_key(t, "Tensor")): RAISE("tensor.transpose expects a tensor") END
    old = t["Tensor"]
    shape = old.get("shape", [])
    data = old.get("data", [])
    IF len(shape) != 2: RAISE("tensor.transpose: expected 2D tensor") END
    rows = int(shape[0]); cols = int(shape[1])
    new = [cols, rows]
    newdata = [0.0 for _ in range(rows*cols)]
    r = 0
    WHILE r < rows:
        c = 0
        WHILE c < cols:
            newdata[c*rows + r] = data[r*cols + c]
            c = c + 1
        END
        r = r + 1
    END
    RETURN({"Tensor": {"shape": new, "dtype": old.get("dtype","float32"), "data": newdata}})
END

DEF builtin_tensor_flatten(exe, args):
    IF len(args) != 1: RAISE("tensor.flatten expects 1 argument") END
    t = args[0]
    IF NOT (type(t) == dict and has_key(t, "Tensor")): RAISE("tensor.flatten expects a tensor") END
    old = t["Tensor"]
    data = old.get("data", [])
    RETURN({"Tensor": {"shape": [len(data)], "dtype": old.get("dtype","float32"), "data": data[:]}})
END

DEF _tensor_binary_op(a, b, op):
    # op is a string: 'add','sub','mul'
    IF NOT (type(a)==dict and has_key(a,"Tensor")):
        RAISE("tensor op: first arg must be tensor")
    END
    at = a["Tensor"]
    IF type(b) == dict and has_key(b, "Tensor"):
        bt = b["Tensor"]
        IF at.get("shape",[]) != bt.get("shape",[]): RAISE("tensor op: shape mismatch") END
        data = []
        FOR i IN range(len(at["data"])):
            av = float(at["data"][i]); bv = float(bt["data"][i])
            IF op == 'add': data.append(av + bv)
            ELIF op == 'sub': data.append(av - bv)
            ELIF op == 'mul': data.append(av * bv)
            END
        END
        RETURN({"Tensor": {"shape": at.get("shape",[]), "dtype": at.get("dtype","float32"), "data": data}})
    ELIF type(b) in (int, float):
        data = []
        FOR v IN at["data"]:
            IF op == 'add': data.append(float(v) + float(b))
            ELIF op == 'sub': data.append(float(v) - float(b))
            ELIF op == 'mul': data.append(float(v) * float(b))
            END
        END
        RETURN({"Tensor": {"shape": at.get("shape",[]), "dtype": at.get("dtype","float32"), "data": data}})
    ELSE:
        RAISE("tensor op: unsupported rhs")
    END
END

DEF builtin_tensor_add(exe, args):
    IF len(args) != 2: RAISE("tensor.add expects 2 arguments") END
    RETURN(_tensor_binary_op(args[0], args[1], 'add'))
END

DEF builtin_tensor_sub(exe, args):
    IF len(args) != 2: RAISE("tensor.sub expects 2 arguments") END
    RETURN(_tensor_binary_op(args[0], args[1], 'sub'))
END

DEF builtin_tensor_mul(exe, args):
    IF len(args) != 2: RAISE("tensor.mul expects 2 arguments") END
    RETURN(_tensor_binary_op(args[0], args[1], 'mul'))
END

# tensor.div
DEF builtin_tensor_div(exe, args):
    IF len(args) != 2: RAISE("tensor.div expects 2 arguments") END
    a = args[0]
    b = args[1]
    IF type(a) != dict or not has_key(a, "Tensor"): RAISE("tensor.div: first arg must be tensor") END
    at = a["Tensor"]
    data_a = at.get("data", [])
    IF type(b) == dict and has_key(b, "Tensor"):
        bt = b["Tensor"]
        IF at.get("shape",[]) != bt.get("shape",[]): RAISE("tensor.div: shape mismatch") END
        data = []
        FOR i IN range(len(data_a)):
            denom = float(bt.get("data",[])[i])
            IF denom == 0.0:
                data.append(float('nan'))
            ELSE:
                data.append(float(data_a[i]) / denom)
            END
        END
        RETURN({"Tensor": {"shape": at.get("shape",[]), "dtype": at.get("dtype","float32"), "data": data}})
    ELIF type(b) in (int, float):
        IF float(b) == 0.0: RAISE("tensor.div: division by zero") END
        data = [float(x)/float(b) for x in data_a]
        RETURN({"Tensor": {"shape": at.get("shape",[]), "dtype": at.get("dtype","float32"), "data": data}})
    ELSE:
        RAISE("tensor.div: expected (tensor, tensor) or (tensor, number)")
    END
END

# tensor.matmul (naive 2D matmul)
DEF builtin_tensor_matmul(exe, args):
    IF len(args) != 2: RAISE("tensor.matmul expects 2 arguments (a,b)") END
    a = args[0]; b = args[1]
    IF type(a) != dict or not has_key(a, "Tensor") or type(b) != dict or not has_key(b, "Tensor"):
        RAISE("tensor.matmul requires two tensors")
    END
    A = a["Tensor"]; B = b["Tensor"]
    if len(A.get("shape",[])) != 2 or len(B.get("shape",[])) != 2:
        RAISE("tensor.matmul: only 2D tensors supported")
    END
    rows = int(A["shape"][0]); mid = int(A["shape"][1]); cols = int(B["shape"][1])
    IF mid != int(B["shape"][0]): RAISE("tensor.matmul: inner dims mismatch") END
    out = [0.0 for _ in range(rows*cols)]
    r = 0
    WHILE r < rows:
        c = 0
        WHILE c < cols:
            s = 0.0
            k = 0
            WHILE k < mid:
                s = s + float(A["data"][r*mid + k]) * float(B["data"][k*cols + c])
                k = k + 1
            END
            out[r*cols + c] = s
            c = c + 1
        END
        r = r + 1
    END
    RETURN({"Tensor": {"shape": [rows, cols], "dtype": A.get("dtype","float32"), "data": out}})
END

# AI helpers (relu, softmax, losses, tensor<->list)
DEF builtin_ai_relu(exe, args):
    IF len(args) != 1: RAISE("ai.relu expects 1 argument") END
    t = args[0]
    IF type(t) != dict or not has_key(t, "Tensor"): RAISE("ai.relu expects a tensor") END
    old = t["Tensor"]
    data = [max(0.0, float(x)) for x in old.get("data",[])]
    RETURN({"Tensor": {"shape": old.get("shape",[]), "dtype": old.get("dtype","float32"), "data": data}})
END

DEF builtin_ai_softmax(exe, args):
    IF len(args) != 1: RAISE("ai.softmax expects 1 argument") END
    t = args[0]
    IF type(t) != dict or not has_key(t, "Tensor"): RAISE("ai.softmax expects a tensor") END
    old = t["Tensor"]
    data = old.get("data",[])
    # simple softmax over full vector
    maxv = max([float(x) for x in data]) if len(data) > 0 else 0.0
    exps = [math_exp(float(x) - maxv) for x in data]
    s = sum(exps)
    IF s == 0.0: res = [0.0 for _ in exps]
    ELSE: res = [e / s for e in exps]
    END
    RETURN({"Tensor": {"shape": old.get("shape",[]), "dtype": old.get("dtype","float32"), "data": res}})
END

DEF builtin_ai_loss_mse(exe, args):
    IF len(args) != 2: RAISE("ai.loss.mse expects 2 arguments") END
    p = args[0]; t = args[1]
    IF type(p) != dict or not has_key(p, "Tensor") or type(t) != dict or not has_key(t, "Tensor"): RAISE("ai.loss.mse expects two tensors") END
    pd = p["Tensor"].get("data",[]); td = t["Tensor"].get("data",[])
    IF len(pd) != len(td): RAISE("MSE loss: tensors must have same size") END
    s = 0.0
    FOR i IN range(len(pd)): d = float(pd[i]) - float(td[i]); s = s + d*d END
    RETURN(float(s / len(pd) if len(pd)>0 else 0.0))
END

DEF builtin_ai_loss_crossentropy(exe, args):
    IF len(args) != 2: RAISE("ai.loss.crossentropy expects 2 arguments") END
    logits = args[0]; target = args[1]
    IF type(logits) != dict or not has_key(logits, "Tensor") or type(target) not in (int, float, dict): RAISE("ai.loss.crossentropy expects (logits_tensor, target_class_number)") END
    data = logits["Tensor"].get("data",[])
    tgt = int(target) if type(target) in (int, float) else int(target.get("Number",0))
    # compute softmax and cross-entropy
    maxv = max([float(x) for x in data]) if len(data)>0 else 0.0
    exps = [math_exp(float(x)-maxv) for x in data]
    s = sum(exps)
    probs = [e/s for e in exps] if s != 0 else [0.0 for _ in exps]
    IF tgt < 0 or tgt >= len(probs): RAISE("ai.loss.crossentropy: target out of range") END
    loss = -math_log(max(probs[tgt], 1e-15))
    RETURN(float(loss))
END

DEF builtin_ai_tensor_to_list(exe, args):
    IF len(args) != 1: RAISE("ai.tensor_to_list expects 1 argument") END
    t = args[0]
    IF type(t) != dict or not has_key(t, "Tensor"): RAISE("ai.tensor_to_list expects a tensor") END
    RETURN([float(x) for x in t["Tensor"].get("data",[])])
END

DEF builtin_ai_list_to_tensor(exe, args):
    IF len(args) != 1: RAISE("ai.list_to_tensor expects 1 argument") END
    items = args[0]
    IF type(items) != list: RAISE("ai.list_to_tensor expects a list") END
    data = []
    FOR it IN items:
        IF type(it) in (int, float): data.append(float(it))
        ELSE: RAISE("ai.list_to_tensor: list must contain only numbers") END
    END
    RETURN({"Tensor": {"shape": [len(data)], "dtype": "float32", "data": data}})
END

