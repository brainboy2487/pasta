# INPUT and env
DEF builtin_input(exe, args):
    # Pure-Pasta note: interactive stdin prompts need host support.
    # TODO: implement editable prompt and line-editing in Pasta.
    IF len(args) > 1: RAISE("INPUT expects 0 or 1 argument (optional prompt)") END
    RETURN(None)
END

DEF builtin_getenv(exe, args):
    IF len(args) != 1: RAISE("GETENV expects 1 argument: variable name") END
    name = Executor_value_to_string(exe, args[0])
    v = getenv(name)
    IF v == None: RETURN(None) END
    RETURN({"String": v})
END

DEF builtin_setenv(exe, args):
    IF len(args) != 2: RAISE("SETENV expects 2 arguments: name, value") END
    name = Executor_value_to_string(exe, args[0])
    value = Executor_value_to_string(exe, args[1])
    TRY:
        os = __import__("os")
        os.environ[name] = value
    EXCEPT:
        pass
    END
    RETURN(None)
END

DEF builtin_argv(exe, args):
    lst = argv_get() if callable(argv_get) else []
    out = []
    FOR a IN lst: out.append({"String": a}) END
    RETURN(out)
END

# Formatting helpers
DEF builtin_format_number(exe, args):
    IF len(args) != 2: RAISE("format_number expects 2 arguments (number, decimals)") END
    n = args[0] if type(args[0]) in (int, float) else 0
    d = int(args[1]) if type(args[1]) in (int, float) else 0
    fmt = "{:.%df}" % d if d >= 0 else "{}"
    TRY:
        s = (fmt).format(n)
    EXCEPT:
        s = str(n)
    END
    RETURN({"String": s})
END

DEF builtin_format_currency(exe, args):
    IF len(args) != 2: RAISE("format_currency expects 2 arguments (amount, symbol)") END
    amt = args[0] if type(args[0]) in (int, float) else 0
    sym = Executor_value_to_string(exe, args[1])
    RETURN({"String": "{}{:.2f}".format(sym, float(amt))})
END

DEF builtin_format_percentage(exe, args):
    IF len(args) != 1: RAISE("format_percentage expects 1 argument") END
    n = args[0] if type(args[0]) in (int, float) else 0
    RETURN({"String": "{:.1}%".format(float(n))})
END

DEF builtin_format_bytes(exe, args):
    IF len(args) != 1: RAISE("format_bytes expects 1 argument") END
    n = int(args[0]) if type(args[0]) in (int, float) else 0
    b = n
    IF b < 1024: RETURN({"String": "{} B".format(b)}) END
    IF b < 1024*1024: RETURN({"String": "{:.1f} KB".format(b / 1024.0)}) END
    IF b < 1024*1024*1024: RETURN({"String": "{:.1f} MB".format(b / 1024.0 / 1024.0)}) END
    RETURN({"String": "{:.1f} GB".format(b / 1024.0 / 1024.0 / 1024.0)})
END

# JSON
DEF builtin_json_parse(exe, args):
    IF len(args) != 1: RAISE("json_parse expects 1 argument") END
    s = Executor_value_to_string(exe, args[0])
    TRY:
        json = __import__("json")
        v = json.loads(s)
        # return Python object as-is (caller must handle)
        RETURN(v)
    EXCEPT AS e:
        RAISE("json_parse: {}".format(str(e)))
    END
END

DEF builtin_json_serialize(exe, args):
    IF len(args) != 1: RAISE("json_serialize expects 1 argument") END
    TRY:
        json = __import__("json")
        s = json.dumps(args[0])
        RETURN({"String": s})
    EXCEPT AS e:
        RAISE("json_serialize: {}".format(str(e)))
    END
END

# --- New system/math builtins from executor.rs slice ---
DEF builtin_exit(exe, args):
    code = int(args[0]) if len(args) >=1 and type(args[0]) in (int, float) else 0
    exit_process(code)
    RETURN(None)
END

DEF builtin_sleep(exe, args):
    IF len(args) != 1: RAISE("sleep expects 1 argument (ms)") END
    IF type(args[0]) not in (int, float): RAISE("sleep: expected number (milliseconds)") END
    ms = float(args[0])
    # simple sleep
    time_sleep(ms / 1000.0)
    RETURN(None)
END

DEF builtin_time(exe, args):
    RETURN(float(time_now_ms() / 1000.0))
END

DEF builtin_time_ms(exe, args):
    RETURN(float(time_now_ms()))
END

DEF builtin_env(exe, args):
    IF len(args) != 1: RAISE("env expects 1 argument (name)") END
    name = Executor_value_to_string(exe, args[0])
    v = getenv(name)
    IF v == None: RETURN({"String": ""}) END
    RETURN({"String": v})
END

DEF builtin_rand(exe, args):
    IF len(args) == 0:
        RETURN(float((time_now_ns() % 1000000) / 1000000.0))
    ELIF len(args) == 1:
        n = args[0]
        IF type(n) in (int, float):
            maxv = int(round(n))
            IF maxv <= 0: maxv = 1 END
            RETURN(float(int(time_now_ns()) % maxv))
        END
        RAISE("rand: expected numeric argument")
    ELSE:
        RAISE("rand: expected 0 or 1 arguments")
    END
END

DEF builtin_rand_int(exe, args):
    IF len(args) != 2: RAISE("rand_int expects 2 arguments (lo, hi)") END
    a = args[0]; b = args[1]
    IF NOT (type(a) in (int, float) and type(b) in (int, float)): RAISE("rand_int: expected two numbers") END
    lo = int(round(a)); hi = int(round(b))
    IF hi < lo: RAISE("rand_int: hi must be >= lo") END
    rng = int(time_now_ns())
    span = hi - lo + 1
    val = lo + (rng % span)
    RETURN(float(val))
END

DEF builtin_rand_range(exe, args):
    IF len(args) != 2: RAISE("rand_range expects 2 arguments (lo, hi)") END
    a = args[0]; b = args[1]
    IF NOT (type(a) in (int, float) and type(b) in (int, float)): RAISE("rand_range: expected two numbers") END
    f = float((time_now_ns() % 1000000) / 1000000.0)
    RETURN(float(a + f * (b - a)))
END

DEF builtin_num(exe, args):
    IF len(args) != 1: RAISE("num/float expects 1 argument") END
    v = args[0]
    IF type(v) in (int, float): RETURN(float(v)) END
    IF type(v) == dict and has_key(v, "String"):
        TRY: RETURN(float(float(v["String"])) )
        EXCEPT: RAISE("num: cannot parse '{}' as number".format(v["String"]))
        END
    IF type(v) == dict and has_key(v, "Bool"):
        RETURN(float(1 if v["Bool"] else 0))
    END
    RAISE("num: cannot convert to number")
END

DEF builtin_int(exe, args):
    IF len(args) != 1: RAISE("int expects 1 argument") END
    v = args[0]
    IF type(v) in (int, float): RETURN(float(int(float(v)))) END
    IF type(v) == dict and has_key(v, "String"):
        TRY: RETURN(float(int(float(v["String"])) ))
        EXCEPT: RAISE("int: cannot parse '{}' as number".format(v["String"]))
        END
    IF type(v) == dict and has_key(v, "Bool"):
        RETURN(float(1 if v["Bool"] else 0))
    END
    RAISE("int: cannot convert to integer")
END

DEF builtin_range(exe, args):
    # supports 1,2,3 numeric args similar to Rust implementation
    IF len(args) == 1 and type(args[0]) in (int, float):
        end = int(round(args[0]))
        out = []
        FOR i IN range(1, end+1): out.append(float(i)) END
        RETURN(out)
    ELIF len(args) == 2 and type(args[0]) in (int,float) and type(args[1]) in (int,float):
        s = int(round(args[0])); e = int(round(args[1]))
        out = []
        IF s <= e:
            FOR i IN range(s, e+1): out.append(float(i)) END
        ELSE:
            FOR i IN range(e, s+1): out.insert(0, float(i)) END
        END
        RETURN(out)
    ELIF len(args) == 3:
        s = int(round(args[0])); e = int(round(args[1])); st = int(round(args[2]))
        IF st == 0: RAISE("range: step cannot be zero") END
        out = []
        cur = s
        IF st > 0:
            WHILE cur <= e: out.append(float(cur)); cur = cur + st END
        ELSE:
            WHILE cur >= e: out.append(float(cur)); cur = cur + st END
        END
        RETURN(out)
    END
    RAISE("range() expects 1,2 or 3 numeric arguments")
END

DEF builtin_color(exe, args):
    IF len(args) != 3: RAISE("color expects 3 arguments (r,g,b)") END
    r = int(args[0]) if type(args[0]) in (int,float) else RAISE("color: r must be a number")
    g = int(args[1]) if type(args[1]) in (int,float) else RAISE("color: g must be a number")
    b = int(args[2]) if type(args[2]) in (int,float) else RAISE("color: b must be a number")
    packed = (0xFF << 24) | ((r & 0xFF) << 16) | ((g & 0xFF) << 8) | (b & 0xFF)
    RETURN(float(packed))
END

