# Format an f64 for display: integers print without a decimal point.
DEF fmt_f64(n):
    IF n == None: RETURN("None") END
    # Consider numeric tolerance similar to f64::EPSILON
    eps = 1e-12
    IF type(n) == int:
        RETURN(str(n))
    ELSE:
        # treat float values close to integers as integers
        IF abs(n - round(n)) < eps:
            RETURN(str(int(round(n))))
        END
        RETURN(str(n))
    END
END

# Diagnostics collector and printer (pure-Pasta)
DIAGNOSTICS = []

DEF ps_print(*args):
    # Collect formatted string into DIAGNOSTICS. Avoid Python print.
    s = ""
    FOR a IN args:
        TRY:
            s = s + Executor_value_to_string(None, a) + " "
        EXCEPT:
            s = s + str(a) + " "
        END
    END
    DIAGNOSTICS.append(s)
    RETURN(None)
END

