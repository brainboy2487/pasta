    pat = Executor_value_to_string(exe, args[1])
    TRY:
        re = __import__("re")
        compiled = re.compile(pat)
        m = compiled.search(s)
        RETURN(bool(m != None))
    EXCEPT AS e:
        RAISE("regex_match: invalid pattern: {}".format(str(e)))
    END
END

DEF builtin_regex_find(exe, args):
    IF len(args) != 2: RAISE("regex_find expects 2 arguments (string, pattern)") END
    s = Executor_value_to_string(exe, args[0])
    pat = Executor_value_to_string(exe, args[1])
    TRY:
        re = __import__("re")
        compiled = re.compile(pat)
        matches = []
        FOR m IN compiled.finditer(s):
            matches.append({"String": m.group(0)})
        END
        RETURN(matches)
    EXCEPT AS e:
        RAISE("regex_find: invalid pattern: {}".format(str(e)))
    END
END

DEF builtin_regex_replace(exe, args):
    IF len(args) != 3: RAISE("regex_replace expects 3 arguments (string, pattern, replacement)") END
    s = Executor_value_to_string(exe, args[0])
    pat = Executor_value_to_string(exe, args[1])
    rep = Executor_value_to_string(exe, args[2])
    TRY:
        re = __import__("re")
        compiled = re.compile(pat)
        out = compiled.sub(rep, s)
        RETURN({"String": out})
    EXCEPT AS e:
        RAISE("regex_replace: invalid pattern: {}".format(str(e)))
    END
END

DEF builtin_regex_captures(exe, args):
    IF len(args) != 2: RAISE("regex_captures expects 2 arguments (string, pattern)") END
    s = Executor_value_to_string(exe, args[0])
    pat = Executor_value_to_string(exe, args[1])
    TRY:
        re = __import__("re")
        compiled = re.compile(pat)
        m = compiled.search(s)
        caps = []
        IF m != None:
            caps.append({"String": m.group(0)})
            FOR i IN range(1, len(m.groups())+1):
                g = m.group(i)
                IF g == None:
                    caps.append(None)
                ELSE:
                    caps.append({"String": g})
                END
            END
        END
        RETURN(caps)
    EXCEPT AS e:
        RAISE("regex_captures: invalid pattern: {}".format(str(e)))
    END
END

# List helpers
DEF builtin_len(exe, args):
    IF len(args) != 1: RAISE("length() takes exactly one argument") END
    a = args[0]
    IF type(a) == list: RETURN(float(len(a))) END
    IF type(a) == dict and has_key(a, "String"): RETURN(float(len(list(a["String"])))) END
    # placeholder for Tensor
    RETURN(float(0))
END

DEF builtin_list_len(exe, args):
