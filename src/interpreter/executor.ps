        RETURN(out)
    END
    RAISE("file_read: path must be string")
END

# High-level helpers: READ_FILE/WRITE_FILE/APPEND_FILE/READ_LINES/WRITE_LINES and aliases
DEF builtin_read_file(exe, args):
    IF len(args) != 1: RAISE("READ_FILE expects 1 argument: path") END
    p = args[0]
    IF type(p) == dict and has_key(p, "String"):
        return_str = fs_read_to_string(p["String"]) or ""
        RETURN({"String": return_str})
    END
    RAISE("READ_FILE: path must be a string")
END

DEF builtin_write_file(exe, args):
    IF len(args) != 2: RAISE("WRITE_FILE expects 2 arguments: path, content") END
    p = args[0]; content_v = args[1]
    IF NOT (type(p) == dict and has_key(p, "String")): RAISE("WRITE_FILE: path must be a string") END
    content = Executor_value_to_string(exe, content_v)
    fs_write_file(p["String"], content)
    RETURN(None)
END

DEF builtin_append_file(exe, args):
    IF len(args) != 2: RAISE("APPEND_FILE expects 2 arguments: path, content") END
    p = args[0]; content_v = args[1]
    IF NOT (type(p) == dict and has_key(p, "String")): RAISE("APPEND_FILE: path must be a string") END
    content = Executor_value_to_string(exe, content_v)
    fs_append_file(p["String"], content)
    RETURN(None)
END

DEF builtin_read_lines(exe, args):
    IF len(args) != 1: RAISE("READ_LINES expects 1 argument: path") END
    p = args[0]
    IF type(p) == dict and has_key(p, "String"):
        s = fs_read_to_string(p["String"]) or ""
        lines = s.split('\n') if s != "" else []
        out = []
        FOR l IN lines:
            IF l.endswith('\r'): l = l[:-1] END
            IF l == "": CONTINUE END
            out.append({"String": l})
        END
        RETURN(out)
    END
    RAISE("READ_LINES: path must be a string")
END

DEF builtin_write_lines(exe, args):
    IF len(args) != 2: RAISE("WRITE_LINES expects 2 arguments: path, lines") END
    p = args[0]; lines_v = args[1]
    IF NOT (type(p) == dict and has_key(p, "String")): RAISE("WRITE_LINES: path must be a string") END
    IF type(lines_v) != list: RAISE("WRITE_LINES: second argument must be a list") END
    parts = []
    FOR itm IN lines_v: parts.append(Executor_value_to_string(exe, itm)) END
    fs_write_file(p["String"], "\n".join(parts) + "\n")
    RETURN(None)
END

