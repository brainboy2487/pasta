# File handle API: OPEN/READLINE/WRITELINE and helpers
DEF builtin_open(exe, args):
    IF len(args) != 2: RAISE("OPEN expects 2 arguments: path, mode") END
    p = args[0]; mode_v = args[1]
    IF NOT (type(p) == dict and has_key(p, "String")): RAISE("OPEN: path must be a string") END
    mode = Executor_value_to_string(exe, mode_v)
    hid = "file://{}".format(exe.get("next_file_id",1))
    exe["next_file_id"] = exe.get("next_file_id",1) + 1
    # store a simple handle mapping; backend file operations use helper fs_* wrappers
    exe["open_files"][hid] = {"path": p["String"], "mode": mode}
    RETURN({"String": hid})
END

DEF builtin_readline(exe, args):
    IF len(args) != 1: RAISE("READLINE expects 1 argument: file handle") END
    h = args[0]
    IF NOT (type(h) == dict and has_key(h, "String")): RAISE("READLINE: handle must be a string") END
    hid = h["String"]
    ent = exe["open_files"].get(hid, None)
    IF ent == None: RAISE("READLINE: unknown handle \"{}\"".format(hid)) END
    # fallback: read entire file and simulate line reads (not stateful)
    s = fs_read_to_string(ent["path"]) or ""
    IF s == "": RETURN(None) END
    first_line = s.split('\n')[0]
    RETURN({"String": first_line.rstrip('\r')})
END

DEF builtin_writeline(exe, args):
    IF len(args) != 2: RAISE("WRITELINE expects 2 arguments: handle, text") END
    h = args[0]; text_v = args[1]
    IF NOT (type(h) == dict and has_key(h, "String")): RAISE("WRITELINE: handle must be a string") END
    hid = h["String"]
    ent = exe["open_files"].get(hid, None)
    IF ent == None: RAISE("WRITELINE: unknown handle \"{}\"".format(hid)) END
    txt = Executor_value_to_string(exe, text_v) + "\n"
    # append to file
    fs_append_file(ent["path"], txt)
    RETURN(None)
END

