        path = args[0]["String"]
    END
    entries = fs_list_dir_long(path)
    RETURN(entries)
END

DEF builtin_shell_mkdir(exe, args):
    IF len(args) == 0 or len(args) > 2: RAISE("mkdir expects 1-2 arguments (path, [parents])") END
    path = args[0]["String"] if type(args[0])==dict and has_key(args[0],"String") else None
    parents = False
    IF len(args) == 2:
        parents = bool(args[1])
    END
    IF path == None: RAISE("mkdir: path must be a string") END
    fs_mkdir_all(path) if parents else fs_mkdir(path)
    RETURN(path)
END

DEF builtin_shell_rm(exe, args):
    IF len(args) != 1: RAISE("rm expects 1 argument (file)") END
    p = args[0]
    IF type(p) == dict and has_key(p, "String"):
        fs_delete_file(p["String"]) 
        RETURN(None)
    END
    RAISE("rm: path must be a string")
END

# rand.choice / seed
DEF builtin_rand_choice(exe, args):
    IF len(args) != 1: RAISE("rand.choice expects 1 arg (list)") END
    lst = args[0]
    IF type(lst) != list: RAISE("rand.choice: argument must be a list") END
    IF len(lst) == 0: RAISE("rand.choice: list is empty") END
    idx = int(time_now_ns()) % len(lst)
    RETURN(lst[idx])
END

DEF builtin_rand_seed(exe, args):
    # No persistent RNG state in this PS runtime; ignore or set exe.rng seed if supported
    IF len(args) >= 1:
        exe["rng_seed"] = int(args[0])
    END
    RETURN(None)
END

# GC builtins
DEF builtin_gc_collect(exe, args):
    n = collect_garbage(exe)
    RETURN(float(n))
END

DEF builtin_gc_count(exe, args):
    # best-effort: try to read allocated_count from strainer if present
    gc = exe.get("gc", None)
    IF gc != None and type(gc) == dict and has_key(gc, "allocated_count"):
        RETURN(float(gc["allocated_count"]))
    END
    RETURN(float(0.0))
END

DEF builtin_gc_stats(exe, args):
    cnt = builtin_gc_count(exe, [])
    RETURN("gc: {} objects live".format(int(cnt)))
END

DEF builtin_gc_pause(exe, args): RETURN(None) END
DEF builtin_gc_resume(exe, args): RETURN(None) END

# debug.* builtins
DEF builtin_debug_print(exe, args):
    FOR v IN args:
        TRY:
            print("[DEBUG] {}".format(value_to_string(v)))
        EXCEPT:
            print("[DEBUG] {}".format(str(v)))
        END
    END
    RETURN(None)
END

DEF builtin_debug_type(exe, args):
    IF len(args) != 1: RAISE("debug.type expects 1 argument") END
    v = args[0]
    t = "unknown"
    IF type(v) in (int, float): t = "number"
    ELIF type(v) == str: t = "string"
    ELIF type(v) == bool: t = "bool"
    ELIF type(v) == list: t = "list"
    ELIF type(v) == dict:
        IF has_key(v, "Tensor"): t = "tensor"
        ELIF has_key(v, "Lambda"): t = "lambda"
        ELIF has_key(v, "LazyImport"): t = "lazy"
        ELIF has_key(v, "Heap"): t = "heap"
        ELIF has_key(v, "Dict"): t = "dict"
        ELIF has_key(v, "Pending"): t = "pending"
        ELIF has_key(v, "Pointer"): t = "pointer"
        ELIF has_key(v, "FamilyNode"): t = "family_node"
        ELIF has_key(v, "Builtin"): t = "builtin"
        ELIF has_key(v, "String"): t = "string"
        ELSE: t = "dict"
        END
    ELIF v == None: t = "none"
    END
    RETURN(t)
END

DEF builtin_debug_len(exe, args):
    IF len(args) != 1: RAISE("debug.len expects 1 argument") END
    v = args[0]
    IF type(v) == list: RETURN(float(len(v))) END
    IF type(v) == dict and has_key(v, "String"): RETURN(float(len(v["String"]))) END
    RAISE("debug.len: expected list or string")
END

DEF builtin_debug_dump(exe, args):
    # best-effort dump of environment
    print(exe.get("env", {}))
    RETURN(None)
END

DEF builtin_debug_trace(exe, args):
    IF len(args) != 1: RAISE("debug.trace expects 1 argument") END
    IF getenv("PASTA_TRACE") != None:
        print("[TRACE] {}".format(value_to_string(args[0])))
    END
    RETURN(None)
END

DEF builtin_debug_assert(exe, args):
    IF len(args) == 0: RAISE("debug.assert expects 1 or 2 arguments") END
    cond = args[0]
    truthy = False
    IF cond == None: truthy = False
    ELIF cond == False: truthy = False
    ELIF type(cond) in (int, float) and cond == 0: truthy = False
    ELIF type(cond) == str and cond == "": truthy = False
    ELSE: truthy = True
    END
    IF NOT truthy:
        msg = "assertion failed"
        IF len(args) >= 2:
            msg = value_to_string(args[1])
        END
        RAISE("[ASSERT] {}".format(msg))
    END
    RETURN(None)
END

DEF builtin_debug_backtrace(exe, args):
    tb = exe.get("traceback", {})
    frames = tb.get("frames", []) if type(tb) == dict else []
    IF len(frames) == 0:
        print("[BACKTRACE]\n  (no frames)")
    ELSE:
        out = []
        i = 0
        FOR f IN frames:
            i = i + 1
            out.append("  #{} {}".format(i, str(f)))
        END
        print("[BACKTRACE]\n" + "\n".join(out))
    END
    RETURN(None)
END

# fs.* builtins (use existing helpers where available)
DEF builtin_fs_read(exe, args):
    IF len(args) != 1: RAISE("fs.read expects 1 argument (path)") END
    p = args[0]
    IF type(p) == dict and has_key(p, "String"):
        RETURN(fs_read_to_string(p["String"]))
    END
    RAISE("fs.read: path must be a string")
END

DEF builtin_fs_write(exe, args):
    IF len(args) != 2: RAISE("fs.write expects 2 arguments (path, content)") END
    p = args[0]
    v = args[1]
    IF type(p) == dict and has_key(p, "String"):
        content = value_to_string(v)
        fs_write_file(p["String"], content)
        RETURN(None)
    END
    RAISE("fs.write: path must be a string")
END

DEF builtin_fs_append(exe, args):
    IF len(args) != 2: RAISE("fs.append expects 2 arguments (path, content)") END
    p = args[0]
    v = args[1]
    IF type(p) == dict and has_key(p, "String"):
        content = value_to_string(v)
        fs_append_file(p["String"], content)
        RETURN(None)
    END
    RAISE("fs.append: path must be a string")
END

DEF builtin_fs_exists(exe, args):
    IF len(args) != 1: RAISE("fs.exists expects 1 argument (path)") END
    p = args[0]
    IF type(p) == dict and has_key(p, "String"):
        RETURN(bool(file_exists(p["String"])))
    END
    RAISE("fs.exists: path must be a string")
END

DEF builtin_fs_delete(exe, args):
    IF len(args) != 1: RAISE("fs.delete expects 1 argument (path)") END
    p = args[0]
    IF type(p) == dict and has_key(p, "String"):
        fs_delete_file(p["String"]) 
        RETURN(None)
    END
    RAISE("fs.delete: path must be a string")
END

DEF builtin_fs_list(exe, args):
    IF len(args) != 1: RAISE("fs.list expects 1 argument (dir)") END
    p = args[0]
    IF type(p) == dict and has_key(p, "String"):
        entries = fs_list_dir(p["String"]) if callable(fs_list_dir) else []
        RETURN([{"String": e} for e in entries])
    END
    RAISE("fs.list: path must be a string")
END
