# Helper: executor-level value_to_string wrapper (uses existing Executor::value_to_string behavior)
DEF Executor_value_to_string(exe, v):
    # If the runtime exposes a utility, prefer it; otherwise, implement a simple fallback
    IF "value_to_string" in exe:
        fn = exe["value_to_string"]
        TRY:
            RETURN(fn(v)
        EXCEPT:
            pass
        END
    END
    # Fallback conversions
    IF type(v) == dict and has_key(v, "String"): RETURN(v["String"]) END
    IF type(v) in (int, float): RETURN(fmt_f64(v)) END
    IF type(v) == list:
        parts = []
        FOR item IN v: parts.append(Executor_value_to_string(exe, item)) END
        RETURN("[" + ",".join(parts) + "]")
    END
    IF v == None: RETURN("") END
    RETURN(str(v))
END

# String/list/regex builtins (translated from executor.rs)
DEF builtin_substr(exe, args):
    IF len(args) < 2 or len(args) > 3: RAISE("substr expects 2 or 3 arguments (string, start [, length])") END
    s = Executor_value_to_string(exe, args[0])
    chars = list(s)
    ln = len(chars)
    start_arg = args[1]
    IF type(start_arg) in (int, float):
        i = int(start_arg) - 1
        IF i < 0: start = 0 ELSE: start = i END
    ELSE:
        RAISE("substr: start must be a number")
    END
    IF start >= ln: RETURN({"String": ""}) END
    take = ln - start
    IF len(args) == 3:
        v = args[2]
        IF type(v) in (int, float):
            take = int(v)
        END
    END
    end = start + take
    RETURN({"String": "".join(chars[start:end])})
END

DEF builtin_regex_match(exe, args):
    IF len(args) != 2: RAISE("regex_match expects 2 arguments (string, pattern)") END
    s = Executor_value_to_string(exe, args[0])
    pat = Executor_value_to_string(exe, args[1])
    TRY:
        re = __import__("re")
        compiled = re.compile(pat)
        m = compiled.search(s)
        RETURN(bool(m != None))
    EXCEPT AS e:
        RAISE("regex_match: invalid pattern: {}".format(str(e)))
    END
END

DEF builtin_regex_find(exe, args):
    IF len(args) != 2: RAISE("regex_find expects 2 arguments (string, pattern)") END
    s = Executor_value_to_string(exe, args[0])
    pat = Executor_value_to_string(exe, args[1])
    TRY:
        re = __import__("re")
        compiled = re.compile(pat)
        matches = []
        FOR m IN compiled.finditer(s):
            matches.append({"String": m.group(0)})
        END
        RETURN(matches)
    EXCEPT AS e:
        RAISE("regex_find: invalid pattern: {}".format(str(e)))
    END
END

DEF builtin_regex_replace(exe, args):
    IF len(args) != 3: RAISE("regex_replace expects 3 arguments (string, pattern, replacement)") END
    s = Executor_value_to_string(exe, args[0])
    pat = Executor_value_to_string(exe, args[1])
    rep = Executor_value_to_string(exe, args[2])
    TRY:
        re = __import__("re")
        compiled = re.compile(pat)
        out = compiled.sub(rep, s)
        RETURN({"String": out})
    EXCEPT AS e:
        RAISE("regex_replace: invalid pattern: {}".format(str(e)))
    END
END

DEF builtin_regex_captures(exe, args):
    IF len(args) != 2: RAISE("regex_captures expects 2 arguments (string, pattern)") END
    s = Executor_value_to_string(exe, args[0])
    pat = Executor_value_to_string(exe, args[1])
    TRY:
        re = __import__("re")
        compiled = re.compile(pat)
        m = compiled.search(s)
        caps = []
        IF m != None:
            # group(0) is full match; include group(0) and subsequent groups
            caps.append({"String": m.group(0)})
            FOR i IN range(1, len(m.groups())+1):
                g = m.group(i)
                IF g == None:
                    caps.append(None)
                ELSE:
                    caps.append({"String": g})
                END
            END
        END
        RETURN(caps)
    EXCEPT AS e:
        RAISE("regex_captures: invalid pattern: {}".format(str(e)))
    END
END

