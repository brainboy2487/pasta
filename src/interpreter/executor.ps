    END
    RETURN({"String": s * cnt})
END

DEF builtin_string_pad_left(exe, args):
    IF len(args) != 3: RAISE("string_pad_left expects 3 arguments (s, width, pad_char)") END
    s = Executor_value_to_string(exe, args[0])
    width_arg = args[1]
    IF type(width_arg) in (int, float):
        width = int(round(width_arg))
    ELSE:
        RAISE("string_pad_left: width must be a number")
    END
    pad_ch = Executor_value_to_string(exe, args[2])
    pad_c = pad_ch[0] if len(pad_ch) > 0 else ' '
    cur_len = len(list(s))
    IF cur_len >= width:
        RETURN({"String": s})
    END
    padding = pad_c * (width - cur_len)
    RETURN({"String": padding + s})
END

DEF builtin_string_pad_right(exe, args):
    IF len(args) != 3: RAISE("string_pad_right expects 3 arguments (s, width, pad_char)") END
    s = Executor_value_to_string(exe, args[0])
    width_arg = args[1]
    IF type(width_arg) in (int, float):
        width = int(round(width_arg))
    ELSE:
        RAISE("string_pad_right: width must be a number")
    END
    pad_ch = Executor_value_to_string(exe, args[2])
    pad_c = pad_ch[0] if len(pad_ch) > 0 else ' '
    cur_len = len(list(s))
    IF cur_len >= width:
        RETURN({"String": s})
    END
    padding = pad_c * (width - cur_len)
    RETURN({"String": s + padding})
END

