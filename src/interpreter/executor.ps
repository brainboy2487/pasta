# --- Object system helpers --------------------------------------------------

# ObjectFamily metadata constructor (mirrors Rust struct fields)
DEF ObjectFamily_new(name, family_group, params, fields, mutation_table, constructor, methods):
    RETURN({
        "name": name,
        "family_group": family_group,
        "params": params or [],
        "fields": fields or [],
        "mutation_table": mutation_table or [],
        "constructor": constructor,
        "methods": methods or []
    })
END

# ObjectInstance and constructor
DEF ObjectInstance_new(id, family, fields):
    IF fields == None: fields = {} END
    RETURN({
        "id": id,
        "family": family,
        "fields": fields,
        "applied_mutations": set()
    })
END

# For compatibility: create an instance from provided fields map
DEF ObjectInstance_create(exe, id, family, fields):
    inst = ObjectInstance_new(id, family, fields)
    exe["objects"][str(id)] = inst
    RETURN(inst)
END

