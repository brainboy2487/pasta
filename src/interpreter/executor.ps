# Executor - translated from src/interpreter/executor.rs (lines 1-400)
# Preserve names and public API surface so behavior matches Rust executor.

# Global debug flag (mirrors AtomicBool in Rust extern)
VERBOSE_DEBUG = False

DEF is_verbose_debug():
    # Return the global debug flag (equivalent to AtomicBool::load)
    RETURN(VERBOSE_DEBUG)
END

