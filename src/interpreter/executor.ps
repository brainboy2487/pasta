    EXCEPT:
        RETURN("")
    END
    RETURN({"String": line})
END

DEF builtin_term_edit_line(exe, args):
    IF len(args) < 1 or len(args) > 2: RAISE("term.edit_line expects 1 or 2 arguments") END
    prompt = Executor_value_to_string(exe, args[0])
    initial = Executor_value_to_string(exe, args[1]) if len(args) >= 2 else ""
    print(prompt, end="")
    TRY:
        s = input()
    EXCEPT:
        s = initial
    END
    RETURN([{"String": s}, {"String": "submit"}])
END

DEF builtin_term_edit_buffer(exe, args):
    RETURN([[], {"String": "ok"}, 0.0, 0.0])
END

