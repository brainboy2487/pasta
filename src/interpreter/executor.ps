# --- FPS system -------------------------------------------------------------
DEF FpsState_new(target_fps):
    # Default and caps mirror Rust FpsState::new
    now = time_instant_now()
    t = target_fps
    IF t == None OR t <= 0.0: t = 60.0 END
    RETURN({
        "target_fps": t,
        "fixed_delta": 1.0 / t,
        "frame_count": 0,
        "paused": False,
        "init_time": now,
        "frame_start": now,
        "last_frame_time_ms": 0.0,
        "frame_times": [],
        "pause_start": None,
        "paused_duration": 0.0
    })
END

# GridConfig struct equivalent
DEF GridConfig_new(cell_width, cell_height):
    RETURN({"cell_width": cell_width, "cell_height": cell_height})
END

# Executor utilities --------------------------------------------------------
PIPELINE_COUNTER = 1

DEF next_pipeline_id():
    global PIPELINE_COUNTER
    id = PIPELINE_COUNTER
    PIPELINE_COUNTER = PIPELINE_COUNTER + 1
    RETURN(id)
END

# Thread-local kill receiver storage (approximation)
# In Rust: thread_local! KILL_RX: RefCell<Option<Receiver<()>>>
KILL_RX = {}

DEF set_kill_rx(rx):
    # store receiver under current thread id (simple approximation)
    tid = thread_id_str()
    KILL_RX[tid] = rx
    RETURN(None)
END

