# rand.int advanced behavior (0/1/2 args) and rand.ls
DEF builtin_rand_int(exe, args):
    ln = len(args)
    IF ln == 0:
        # 31-bit-ish random via time_ns
        RETURN(float(int(time_now_ns()) & 0x7FFFFFFF))
    ELIF ln == 1:
        a = args[0]
        IF type(a) in (int, float):
            maxv = int(a)
            IF maxv <= 0:
                RETURN(float(0))
            END
            RETURN(float(int(time_now_ns()) % maxv))
        END
        RAISE("rand.int: expected numeric argument")
    ELIF ln == 2:
        a = args[0]; b = args[1]
        IF type(a) in (int, float) and type(b) in (int, float):
            mn = int(a); mx = int(b)
            IF mx <= mn:
                RETURN(float(mn))
            END
            rng = int(time_now_ns())
            RETURN(float((rng % (mx - mn)) + mn))
        END
        RAISE("rand.int: expected two numeric arguments")
    ELSE:
        RAISE("rand.int: expected 0, 1, or 2 arguments")
    END
END

DEF builtin_rand_ls(exe, args):
    n = int(args[0]) if len(args) >= 1 and type(args[0]) in (int, float) else 8
    res = []
    FOR i IN range(n):
        res.append(float((time_now_ns() % 1000000) / 1000000.0))
    END
    RETURN(res)
END

# tensor.* helpers (basic implementations)
DEF builtin_tensor_rand(exe, args):
    IF len(args) != 1: RAISE("tensor.rand expects 1 argument (shape)") END
    shape_arg = args[0]
    IF type(shape_arg) == dict and has_key(shape_arg, "List"):
        dims = [int(x) for x in shape_arg["List"]]
    ELIF type(shape_arg) == list:
        dims = [int(x) if type(x) in (int,float) else 0 for x in shape_arg]
    ELIF type(shape_arg) in (int, float):
        dims = [int(shape_arg)]
    ELSE:
        RAISE("tensor.rand: argument must be a list or number")
    END
    numel = 1
    FOR d IN dims: numel = numel * d END
    seed = int(time_now_ns())
    state = seed ^ 0xDEADBEEFCAFEBABE
    data = []
    FOR _ IN range(numel):
        state = (state * 6364136223846793005 + 1442695040888963407) & ((1<<64)-1)
        data.append(float((state >> 33) & 0xFFFFFFFF) / float(0xFFFFFFFF))
    END
    # Represent tensor as dict: {"Tensor": {"shape": dims, "dtype":"float32", "data": data}}
    RETURN({"Tensor": {"shape": dims, "dtype": "float32", "data": data}})
END

DEF builtin_tensor_eye(exe, args):
    IF len(args) != 1: RAISE("tensor.eye expects 1 argument (n)") END
    n = int(args[0]) if type(args[0]) in (int, float) else 0
    data = [0.0 for _ in range(n*n)]
    i = 0
    WHILE i < n:
        data[i*n + i] = 1.0
        i = i + 1
    END
    RETURN({"Tensor": {"shape": [n, n], "dtype": "float32", "data": data}})
END

DEF builtin_tensor_from_list(exe, args):
    IF len(args) != 1: RAISE("tensor.from_list expects 1 argument") END
    items = args[0]
    IF type(items) != list: RAISE("tensor.from_list: argument must be a list") END
    data = []
    FOR item IN items:
        IF type(item) in (int, float): data.append(float(item))
        ELSE: RAISE("tensor.from_list: non-numeric element") END
    END
    RETURN({"Tensor": {"shape": [len(data)], "dtype": "float32", "data": data}})
END

