DEF math_ceil(x):
    IF type(x) in (int,float):
        xi = int(round(x))
        IF xi < x: RETURN(float(xi + 1)) END
        RETURN(float(xi)
    END
    RETURN(float(0))
END

# vdbg macro equivalent as helper function (uses ps_print)
DEF vdbg(self, *args):
    IF ("verbose" in self and self["verbose"]) and is_verbose_debug():
        # join args into a formatted string
        s = ""
        FOR a IN args:
            s = s + Executor_value_to_string(self, a) + " "
        END
        ps_print(s)
    END
END

# Object-family helpers (preserve names)
DEF find_object_family(exe, name):
    IF name == None: RETURN(None) END
    IF has_key(exe["object_families"], name): RETURN(exe["object_families"][name]) END
    RETURN(None)
END

DEF has_function_name(exe, name):
    IF name == None: RETURN(False) END
    RETURN(has_key(exe["functions"], name))
END

DEF object_group_from_decl(group):
    IF group == None: RETURN("Nrml") END
    g = group
    # Support CSM composite group with default primary/empty extensions
    IF type(g) == str:
        gu = g.upper()
        IF gu == "LST" OR gu == "LIST" OR gu == "ARY" OR gu == "ARRAY": RETURN("Lst") END
        IF gu == "DICT": RETURN("Dict") END
        IF gu == "TNSR" OR gu == "TENSOR": RETURN("Tnsr") END
        IF gu == "CSM": RETURN({"primary": "Nrml", "extensions": []}) END
    END
    RETURN("Nrml")
END

# create object instance helper
DEF create_object_family_node(exe, family_name, family_group, parent_a_id, parent_b_id, fields):
    id = exe["next_object_id"]
    exe["next_object_id"] = id + 1
    obj = {"id": id, "family": family_name, "fields": fields or {}, "applied_mutations": []}
    exe["objects"][str(id)] = obj
    RETURN({"FamilyNode": {"id": id, "mutable": True}})
END

# Module resolution: robust path search mirroring Rust resolve_module_path
DEF resolve_module_path(exe, name):
    IF name == None: RAISE("ModuleNotFound: no name provided") END
    cwd = fs_cwd()
    candidates = [
        path_join(cwd, name + ".pm"),
        path_join(cwd, "modules", name + ".pm")
    ]
    env_paths = getenv("PASTA_MODULE_PATH")
    IF env_paths != None:
        FOR dir IN split(env_paths, ":"):
            IF dir != "":
                candidates.append(path_join(dir, name + ".pm"))
            END
        END
    END
    candidates.append(path_join(cwd, "src", "stdlib", name + ".pm"))
    candidates.append(path_join(cwd, "stdlib", name + ".pm"))

    FOR p IN candidates:
        IF file_exists(p): RETURN(p) END
    END
    RAISE("ModuleNotFound: '{}' (searched: {})".format(name, ", ".join(candidates)))
END

# Resolve shared module path (lib*.so) - simplified
DEF resolve_shared_module_path(exe, name):
    cwd = fs_cwd()
    candidates = [
        path_join(cwd, "lib" + name + ".so"),
        path_join(cwd, "modules", "lib" + name + ".so"),
        path_join(cwd, name + ".so"),
        path_join(cwd, "modules", name + ".so")
    ]
    env_paths = getenv("PASTA_MODULE_PATH")
    IF env_paths != None:
        FOR dir IN split(env_paths, ":"):
            IF dir != "":
                candidates.append(path_join(dir, "lib" + name + ".so"))
                candidates.append(path_join(dir, name + ".so"))
            END
        END
    END
    FOR p IN candidates:
        IF file_exists(p): RETURN(p) END
    END
    RAISE("CompiledModuleNotFound: '{}' (searched: {})".format(name, ", ".join(candidates)))
END

# Module loader - simplified translator of load_module
DEF load_module(exe, name):
    # If already loaded, nothing to do.
    IF has_key(exe["loaded_modules"], name): RETURN(None) END

    # Check registry for loading state (circular import)
    meta = get_module_registry_entry(exe, name)
    IF meta != None and meta["state"] == "Loading":
        RAISE("CircularImportError: circular import detected while loading '{}'".format(name))
    END

    # Mark registry as loading and attempt to find path
    set_module_registry_state(exe, name, "Loading")
    # Try module path
    TRY:
        path = resolve_module_path(exe, name)
        # register and mark
        module_registry_register(exe, name, path)
        set_module_registry_state(exe, name, "Loading")
        # load script module
        exports = load_pasta_module_from_path(exe, path, name)
        exe["loaded_modules"][name] = exports
        set_module_registry_state(exe, name, "Loaded")
        RETURN(None)
    EXCEPT:
        # Not found as script; try shared module
        TRY:
            libpath = resolve_shared_module_path(exe, name)
            module_registry_register(exe, name, libpath)
            set_module_registry_state(exe, name, "Loading")
            # load native library
            native_exports = load_native_module(exe, name, libpath)
            exe["loaded_modules"][name] = native_exports
            set_module_registry_state(exe, name, "Loaded")
            RETURN(None)
        EXCEPT AS e:
            module_registry_mark_failed(exe, name, str(e))
            set_module_registry_state(exe, name, "NotFound")
            RAISE("ModuleNotFound: '{}'".format(name))
        END
    END
END

# Module registry helpers
DEF get_module_registry_entry(exe, name):
    IF has_key(exe["module_registry"], name):
        RETURN(exe["module_registry"][name])
    END
    RETURN(None)
END

DEF module_registry_register(exe, name, path):
    exe["module_registry"][name] = {"path": path, "state": "Registered", "exports": []}
    RETURN(None)
END

DEF module_registry_mark_failed(exe, name, reason):
    exe["module_registry"][name] = {"path": exe["module_registry"].get(name, {}).get("path", None), "state": "Failed", "reason": reason}
    RETURN(None)
END

DEF set_module_registry_state(exe, name, state):
    entry = exe["module_registry"].get(name, None)
    IF entry == None:
        exe["module_registry"][name] = {"path": None, "state": state, "exports": []}
    ELSE:
        entry["state"] = state
        exe["module_registry"][name] = entry
    END
    RETURN(None)
END

DEF module_registry_set_exports(exe, name, exports):
    entry = exe["module_registry"].get(name, None)
    IF entry == None:
        exe["module_registry"][name] = {"path": None, "state": "Loaded", "exports": exports}
    ELSE:
        entry["exports"] = exports
        exe["module_registry"][name] = entry
    END
    RETURN(None)
END

# Load a Pasta source module from a filesystem path and execute top-level statements
DEF load_pasta_module_from_path(exe, path):
    # Read and parse the file
    src = fs_read_to_string(path)
    tokens = Lexer_new(src).lex()
    parser = Parser_new(tokens)
    program = parser.parse()

    # Collect exports from any ModuleDecl in the program.
    exports_list = []
    FOR s IN program["statements"]:
        IF s["type"] == "ModuleDecl":
            FOR e IN s.get("exports", []):
                exports_list.append(e["name"])
            END
        END
    END

    # Execute all top-level statements in a fresh isolated scope.
    ex_frame_push_scope(exe["env"], "Function")

    # Pre-register all function definitions so forward-calls work.
    register_functions_recursive(exe, program["statements"])

    FOR stmt IN program["statements"]:
        IF stmt["type"] == "ModuleDecl":
            # execute DEFs inside ModuleDecl body
            FOR inner IN stmt.get("body", []):
                TRY:
                    execute_statement(exe, inner)
                EXCEPT AS e:
                    module_registry_mark_failed(exe, path, str(e))
                    ex_frame_pop_scope(exe["env"], "module load", exe["diagnostics"])
                    RAISE("ModuleLoadError: failed to execute module '{}' : {}".format(path, str(e)))
                END
            END
            CONTINUE
        END
        TRY:
            execute_statement(exe, stmt)
        EXCEPT AS e:
            module_registry_mark_failed(exe, path, str(e))
            ex_frame_pop_scope(exe["env"], "module load", exe["diagnostics"])
            RAISE("ModuleLoadError: failed to execute module '{}' : {}".format(path, str(e)))
        END
    END

    # Collect exports map
    exports_map = {}
    FOR export_name IN exports_list:
        v = env_get(exe, export_name)
        IF v == None:
            module_registry_mark_failed(exe, path, "module '{}' does not export '{}'".format(path, export_name))
            ex_frame_pop_scope(exe["env"], "module export check", exe["diagnostics"])
            RAISE("ExportNotFoundError: module '{}' does not export '{}'".format(path, export_name))
        END
        exports_map[export_name] = v
    END

    ex_frame_pop_scope(exe["env"], "module load complete", exe["diagnostics"])
    module_registry_set_exports(exe, path, exports_list)
    RETURN(exports_map)
END

# Load native compiled module and register builtins
DEF load_native_module(exe, name, path):
    native_module = NativeModule_load(path, name)
    builtins = native_module.export_builtins(name)
    exports = native_module.exports()
    exports_map = {}
    FOR export IN exports:
        builtin_name = "__native::" + name + "::" + export
        IF has_key(builtins, builtin_name):
            exe["builtin_registry"][builtin_name] = builtins[builtin_name]
            exports_map[export] = {"Builtin": builtin_name}
        ELSE:
            RAISE("compiled module '{}' missing wrapper closure for export '{}'".format(name, export))
        END
    END
    exe["loaded_modules"][name] = exports_map
    module_registry_set_exports(exe, name, exports)
    set_module_registry_state(exe, name, "Loaded")
    RETURN(exports_map)
END

# Get an exported value from a loaded module, loading it if necessary.
DEF get_module_export(exe, module, symbol):
    # Check if this is a stdlib (Rust-level) module.
    IF has_key(exe["stdlib_module_exports"], module):
        exports = exe["stdlib_module_exports"][module]
        IF any(lambda e: e == symbol, exports):
            # Load the matching extension if not already loaded.
            load_extension(exe, module)
            RETURN({"Builtin": symbol})
        END
        RAISE("ExportNotFoundError: module '{}' does not export '{}'".format(module, symbol))
    END
    IF NOT has_key(exe["loaded_modules"], module):
        load_module(exe, module)
    END
    IF has_key(exe["loaded_modules"], module):
        exports = exe["loaded_modules"][module]
        IF has_key(exports, symbol):
            RETURN(exports[symbol])
        END
    END
    RAISE("ExportNotFoundError: module '{}' does not export '{}'".format(module, symbol))
END

# Instantiate an object of a family with optional overrides
DEF instantiate_object(exe, family_name, overrides=None):
    IF NOT has_key(exe["object_families"], family_name):
        RAISE("unknown object family '{}'".format(family_name))
    END
    fam = exe["object_families"][family_name]
    fields_map = {}
    FOR f IN fam.get("fields", []):
        TRY:
            v = eval_expr(exe, f["value"])
            fields_map[f["name"]["name"]] = v
        EXCEPT:
            fields_map[f["name"]["name"]] = None
        END
    END
    IF overrides != None:
        FOR k,v IN overrides.items():
            fields_map[k] = v
        END
    END
    id = exe["next_object_id"]
    exe["next_object_id"] = max_int_add(id, 1)  # saturating add approximation
    inst = {"id": id, "family": family_name, "fields": fields_map, "applied_mutations": []}
    exe["objects"][str(id)] = inst
    RETURN(id)
END

# Apply a mutation to an object instance
DEF apply_mutation(exe, object_id, mutation_name):
    IF NOT has_key(exe["objects"], str(object_id)):
        RAISE("object id {} not found".format(object_id))
    END
    inst = exe["objects"][str(object_id)]
    inst_family = inst["family"]
    IF NOT has_key(exe["object_families"], inst_family):
        RAISE("family '{}' not registered".format(inst_family))
    END
    fam = exe["object_families"][inst_family]
    mut_entry = None
    FOR m IN fam.get("mutation_table", []):
        IF m["name"]["name"] == mutation_name:
            mut_entry = m
            BREAK
        END
    END
    IF mut_entry == None:
        RAISE("mutation '{}' not found on family '{}'".format(mutation_name, fam["name"]))
    END
    body = mut_entry.get("body")
    IF body["type"] == "Expr":
        eval_expr(exe, body["expr"])
    ELSE:
        FOR s IN body.get("stmts", []):
            execute_statement(exe, s)
            IF exe["control_flow"] != None: BREAK END
        END
    END
    # mark mutation applied
    inst["applied_mutations"].append(mutation_name)
    exe["objects"][str(object_id)] = inst
    RETURN(None)
END

# Traceback helpers
DEF push_frame(exe, span, ctx):
    ex_frame_push_frame(exe["traceback"], span, ctx)
    RETURN(None)
END

DEF pop_frame(exe):
    ex_frame_pop_frame(exe["traceback"])
    RETURN(None)
END

# Configuration
DEF set_while_limit(exe, limit):
    exe["while_limit"] = limit
    RETURN(None)
END

# Extension registration
DEF register_builtin(exe, name, func):
    exe["builtin_registry"][name] = func
    RETURN(None)
END

# Load extension
DEF load_extension(exe, extension_name):
    IF has_key(exe["loaded_extensions"], extension_name): RETURN(None) END
    IF extension_name == "graphics":
        register_graphics_api(exe)
        register_color_palette(exe["env"])  # populates named colors
        exe["loaded_extensions"].append(extension_name)
        RETURN(None)
    ELIF extension_name == "fps":
        register_fps_api(exe)
        exe["loaded_extensions"].append(extension_name)
        RETURN(None)
    ELSE:
        RAISE("Unknown extension: {}".format(extension_name))
    END
END

# GC
DEF collect_garbage(exe):
    roots = env_all_values(exe)
    RETURN(strainer_collect_with_roots(exe["gc"], roots))
END

# Deref helpers
DEF deref(exe, v):
    WHILE type(v) == dict and has_key(v, "Heap"):
        id = v["Heap"]
        inner = strainer_get(exe["gc"], id)
        IF inner == None: RETURN(None) END
        v = inner
    END
    RETURN(v)
END

DEF deref_return(exe, v):
    IF type(v) == dict and has_key(v, "Heap"):
        id = v["Heap"]
        inner = strainer_get(exe["gc"], id)
        IF inner != None and (inner["type"] == "Dict" OR inner["type"] == "List"):
            RETURN(v)
        END
    END
    RETURN(deref(exe, v))
END

# Load header if exists
DEF load_header_if_exists(exe, path):
    IF NOT file_exists(path): RETURN(None) END
    src = fs_read_to_string(path)
    IF src == None:
        exe["diagnostics"].append("I/O error reading {}".format(path))
        RETURN(None)
    END
    lex_res = Lexer_new(src).lex_result()
    IF lex_res["ok"] == False:
        exe["diagnostics"].append("Lex error loading {}:{}:{}".format(path, lex_res["line"], lex_res["col"]))
        RETURN(None)
    END
    parser = Parser_new(lex_res["tokens"])
    program, parse_diags = parser.parse_with_diagnostics()
    FOR d IN parse_diags:
        print("Parse error at {}:{}: {}".format(d["span"]["start_line"], d["span"]["start_col"], d["message"]))
    END
    TRY:
        execute_repl(exe, program)
        IF exe["verbose"]:
            exe["diagnostics"].append("Loaded header {}".format(path))
        END
    EXCEPT AS e:
        msg = "Failed to execute header {}: {}".format(path, str(e))
        IF "Undefined variable" not in msg:
            exe["diagnostics"].append(msg)
        END
    END
    RETURN(None)
END

# Register functions recursively
DEF register_functions_recursive(exe, stmts):
    FOR stmt IN stmts:
        t = stmt["type"]
        IF t == "FunctionDef":
            name = stmt["name"]["name"]
            params = stmt["params"]
            body = stmt["body"]
            exe["functions"][name] = {"params": params, "body": body}
            # alias short name if dotted
            IF name.find('.') != -1:
                pos = name.rfind('.')
                short = name[pos+1:]
                IF NOT has_key(exe["functions"], short):
                    exe["functions"][short] = {"params": params, "body": body}
                END
                IF len(params) == 0:
                    env_set_global(exe, short, {"Lambda": {"params": params, "body": body}})
                END
            END
            IF len(params) == 0:
                env_set_global(exe, name, {"Lambda": {"params": params, "body": body}})
            END
            register_functions_recursive(exe, body)
        ELIF t == "DoBlock":
            register_functions_recursive(exe, stmt["body"])
        ELIF t == "WhileBlock":
            register_functions_recursive(exe, stmt["body"])
        ELIF t == "ForIn":
            register_functions_recursive(exe, stmt["body"])
        ELIF t == "If":
            register_functions_recursive(exe, stmt["then_body"])
            IF has_key(stmt, "else_body") and stmt["else_body"] != None:
                register_functions_recursive(exe, stmt["else_body"])
            END
        ELIF t == "DefDoUntil":
            register_functions_recursive(exe, stmt["d"]["body"])
        END
    END
END

# Execute program (two-pass)
DEF execute_program(exe, program):
    register_functions_recursive(exe, program["statements"])
    FOR stmt IN program["statements"]:
        IF stmt["type"] == "FunctionDef":
            name = stmt["name"]["name"]
            params = stmt["params"]
            body = stmt["body"]
            exe["functions"][name] = {"params": params, "body": body}
            env_set_global(exe, name, {"Lambda": {"params": params, "body": body}})
        END
    END

    stmts = program["statements"]
    i = 0
    WHILE i < len(stmts):
        stmt = stmts[i]
        IF stmt["type"] == "DefDoUntil":
            i = i + 1
            CONTINUE
        END
        TRY:
            execute_statement(exe, stmt)
        EXCEPT AS e:
            IF exe["verbose"] and is_verbose_debug():
                FOR msg IN exe["diagnostics"]:
                    print("note: {}".format(msg))
                END
            END
            RAISE(e)
        END
        collect_garbage(exe)
        # Handle top-level control flow signals
        cf = exe["control_flow"]
        exe["control_flow"] = None
        IF cf != None:
            IF cf["type"] == "GotoLabel":
                label_clone = cf["label"]
                target = find_position(stmts[i+1:], lambda s: s["type"] == "LoopBlock" and s["name"] == label_clone)
                IF target != None:
                    i = i + 1 + target
                    exe["control_flow"] = {"type": "GotoLabel", "label": label_clone}
                    CONTINUE
                END
            END
            # Other signals cleared
        END
        i = i + 1
    END

    # validate constraints
    IF NOT constraints_validate_all(exe["constraints"]):
        msg = "Constraint validation failed"
        IF exe["verbose"] and is_verbose_debug():
            exe["diagnostics"].append(msg)
            FOR m IN exe["diagnostics"]:
                print("note: {}".format(m))
            END
        END
        RAISE(msg)
    END
    RETURN(None)
END

# Execute in REPL mode
DEF execute_repl(exe, program):
    # Pipeline short-circuit: single expression that is a pipe
    IF len(program["statements"]) == 1:
        stmt = program["statements"][0]
        IF stmt["type"] == "ExprStmt":
            expr = stmt["expr"]
            IF expr["type"] == "Binary" and expr["op"] == "Pipe":
                left_clone = expr["left"]
                right_clone = expr["right"]
                TRY:
                    spawn_pipeline_detached(exe, left_clone, right_clone, "pipeline")
                EXCEPT AS e:
                    print("Failed to spawn pipeline: {}".format(str(e)))
                END
                RETURN(None)
            END
        END
    END

    FOR stmt IN program["statements"]:
        execute_statement(exe, stmt)
        IF exe["control_flow"] != None: BREAK END
    END
    RETURN(None)
END

# Dispatch a single AST statement
DEF execute_statement(exe, stmt):
    # Poll kill channel
    killed = False
    tid = thread_id_str()
    IF has_key(KILL_RX, tid) and KILL_RX[tid] != None:
        rx = KILL_RX[tid]
        killed = rx_try_recv(rx)
    END
    IF killed:
        exe["control_flow"] = {"type": "Killed"}
        RAISE("thread killed")
    END

    # Compute span from statement variant
    stype = stmt["type"]
    span = stmt.get("span", None)
    # Push frame, delegate to ex_eval, pop frame
    ex_frame_push_frame(exe["traceback"], span, "statement")
    res = ex_eval_eval_stmt(exe, stmt)
    ex_frame_pop_frame(exe["traceback"])
    RETURN(res)
END

# Run one statement
DEF run_stmt(exe, stmt):
    execute_statement(exe, stmt)
    RETURN(None)
END

# Evaluate expression via ex_eval
DEF eval_expr(exe, expr):
    RETURN(ex_eval_eval_expr(exe, expr))
END

# Call a Value as callable
DEF call_value(exe, val, args):
    v = deref(exe, val)
    IF type(v) == dict and has_key(v, "Lambda"):
        params = v["Lambda"]["params"]
        stmts = v["Lambda"]["body"]
        # push scope
        env_push_scope(exe, "Function")
        IF len(params) != 0:
            FOR i, param IN enumerate(params):
                val_arg = args[i] if i < len(args) else None
                env_set_local(exe, param["name"], val_arg)
            END
        ELSE:
            FOR i IN range(len(args)):
                env_set_local(exe, "__arg_{}__".format(i), args[i])
            END
        END
        last = None
        FOR s IN stmts:
            res = execute_statement(exe, s)
            IF res != None:
                last = res
            END
            IF exe["control_flow"] != None and exe["control_flow"]["type"] == "Return":
                ret_val = exe["control_flow"]["value"]
                ret_concrete = deref(exe, ret_val)
                TRY:
                    env_pop_scope(exe)
                EXCEPT AS e:
                    exe["diagnostics"].append("Warning: pop_scope in call_value: {}".format(str(e)))
                END
                RETURN(ret_concrete)
            END
        END
        TRY:
            env_pop_scope(exe)
        EXCEPT AS e:
            exe["diagnostics"].append("Warning: pop_scope after call_value: {}".format(str(e)))
        END
        IF has_key(exe, "ret_late_pending") and exe["ret_late_pending"] != None:
            last = exe["ret_late_pending"]
            exe["ret_late_pending"] = None
        END
        RETURN(last)
    ELIF type(v) == dict and has_key(v, "Builtin"):
        name = v["Builtin"]
        RETURN(call_builtin(exe, name, args))
    ELSE:
        RAISE("call_value: not callable")
    END
END

# Execute a value as callable (lists/lambdas)
DEF execute_value_as_callable(exe, value, alias, name_hint):
    IF type(value) == dict and has_key(value, "Lambda"):
        push_frame(exe, {"dummy": True}, "call {}".format(name_hint))
        stmts = value["Lambda"]["body"]
        env_push_scope(exe, "Function")
        IF alias != None:
            env_set_local(exe, alias["name"], {"String": name_hint})
        END
        FOR s IN stmts:
            execute_statement(exe, s)
            IF exe["control_flow"] != None: BREAK END
            collect_garbage(exe)
        END
        TRY:
            env_pop_scope(exe)
        EXCEPT AS e:
            exe["diagnostics"].append("Warning: pop_scope after list-item lambda call: {}".format(str(e)))
        END
        pop_frame(exe)
    ELIF type(value) == list:
        items = value[:]
        FOR item IN items:
            execute_value_as_callable(exe, item, alias, name_hint)
            collect_garbage(exe)
        END
    END
    RETURN(None)
END

# Graphics API registration and helpers
DEF get_canvas_for_draw(exe, handle):
    IF handle == None: RETURN(None) END
    IF has_key(exe["canvases"], handle):
        RETURN(exe["canvases"][handle])
    END
    RETURN(None)
END

DEF get_back_buffer(exe, win_h):
    IF win_h == None: RETURN(None) END
    IF has_key(exe["back_buffers"], win_h):
        RETURN(exe["back_buffers"][win_h])
    END
    RETURN(None)
END

DEF canvas_set_pixel(canvas, x, y, color):
    IF canvas == None: RETURN(False) END
    w = canvas["width"]
    h = canvas["height"]
    IF x < 0 or y < 0 or x >= w or y >= h:
        RETURN(False)
    END
    idx = int(y) * int(w) + int(x)
    canvas["pixels"][idx] = color
    RETURN(True)
END

DEF draw_line_on_canvas(canvas, x0, y0, x1, y1, color):
    x0 = int(x0); y0 = int(y0); x1 = int(x1); y1 = int(y1)
    dx = abs(x1 - x0)
    sx = 1 if x0 < x1 else -1
    dy = -abs(y1 - y0)
    sy = 1 if y0 < y1 else -1
    err = dx + dy
    cx = x0
    cy = y0
    WHILE True:
        canvas_set_pixel(canvas, cx, cy, color)
        IF cx == x1 and cy == y1:
            BREAK
        END
        e2 = 2 * err
        IF e2 >= dy:
            err = err + dy
            cx = cx + sx
        END
        IF e2 <= dx:
            err = err + dx
            cy = cy + sy
        END
    END
    RETURN(None)
END

DEF draw_circle_on_canvas(canvas, cx, cy, r, color):
    x = int(r)
    y = 0
    err = 0
    WHILE x >= y:
        canvas_set_pixel(canvas, cx + x, cy + y, color)
        canvas_set_pixel(canvas, cx + y, cy + x, color)
        canvas_set_pixel(canvas, cx - y, cy + x, color)
        canvas_set_pixel(canvas, cx - x, cy + y, color)
        canvas_set_pixel(canvas, cx - x, cy - y, color)
        canvas_set_pixel(canvas, cx - y, cy - x, color)
        canvas_set_pixel(canvas, cx + y, cy - x, color)
        canvas_set_pixel(canvas, cx + x, cy - y, color)
        y = y + 1
        IF err <= 0:
            err = err + 2*y + 1
        ELSE:
            x = x - 1
            err = err - 2*x + 1
        END
    END
    RETURN(None)
END

DEF fill_circle_on_canvas(canvas, cx, cy, r, color):
    r = int(r)
    FOR dy IN range(-r, r+1):
        dx = int((r*r - dy*dy) ** 0.5)
        FOR x IN range(cx - dx, cx + dx + 1):
            canvas_set_pixel(canvas, x, cy + dy, color)
        END
    END
    RETURN(None)
END

DEF draw_triangle_on_canvas(canvas, x0,y0,x1,y1,x2,y2,color):
    draw_line_on_canvas(canvas, x0,y0,x1,y1,color)
    draw_line_on_canvas(canvas, x1,y1,x2,y2,color)
    draw_line_on_canvas(canvas, x2,y2,x0,y0,color)
    RETURN(None)
END

DEF point_in_triangle(px,py, x0,y0,x1,y1,x2,y2):
    denom = (y1 - y2)*(x0 - x2) + (x2 - x1)*(y0 - y2)
    IF denom == 0: RETURN(False) END
    a = ((y1 - y2)*(px - x2) + (x2 - x1)*(py - y2)) / denom
    b = ((y2 - y0)*(px - x2) + (x0 - x2)*(py - y2)) / denom
    c = 1 - a - b
    RETURN(a >= 0 and b >= 0 and c >= 0)
END

DEF fill_triangle_on_canvas(canvas, x0,y0,x1,y1,x2,y2,color):
    minx = min(x0,x1,x2)
    maxx = max(x0,x1,x2)
    miny = min(y0,y1,y2)
    maxy = max(y0,y1,y2)
    FOR yy IN range(int(miny), int(maxy)+1):
        FOR xx IN range(int(minx), int(maxx)+1):
            IF point_in_triangle(xx,yy,x0,y0,x1,y1,x2,y2):
                canvas_set_pixel(canvas, xx, yy, color)
            END
        END
    END
    RETURN(None)
END

# Builtin wrappers that match call_builtin signature
DEF builtin_blend_to_buffer(exe, args):
    IF len(args) != 3: RAISE("BLEND_TO_BUFFER: expected 3 args") END
    win_h = args[0]["String"] if type(args[0]) == dict and has_key(args[0], "String") else None
    canvas_h = args[1]["String"] if type(args[1]) == dict and has_key(args[1], "String") else None
    alpha = args[2] if type(args[2]) in (int, float) else None
    IF win_h == None or canvas_h == None or alpha == None: RAISE("BLEND_TO_BUFFER: bad args") END
    back = get_back_buffer(exe, win_h)
    canvas = get_canvas_for_draw(exe, canvas_h)
    IF back == None: RAISE("BLEND_TO_BUFFER: unknown window handle '{}'".format(win_h)) END
    IF canvas == None: RAISE("BLEND_TO_BUFFER: unknown canvas handle '{}'".format(canvas_h)) END
    a = max(0.0, min(1.0, float(alpha)))
    bw = int(back["width"]); bh = int(back["height"])
    cw = int(canvas["width"]); ch = int(canvas["height"])
    w = min(bw, cw); h = min(bh, ch)
    FOR y IN range(0, h):
        FOR x IN range(0, w):
            bpx = back["pixels"][y*bw + x]
            cpx = canvas["pixels"][y*cw + x]
            br = (bpx >> 16) & 0xFF
            bg = (bpx >> 8) & 0xFF
            bb = bpx & 0xFF
            cr = (cpx >> 16) & 0xFF
            cg = (cpx >> 8) & 0xFF
            cb = cpx & 0xFF
            nr = int(round(cr * a + br * (1.0 - a)))
            ng = int(round(cg * a + bg * (1.0 - a)))
            nb = int(round(cb * a + bb * (1.0 - a)))
            back["pixels"][y*bw + x] = 0xFF000000 | (nr << 16) | (ng << 8) | nb
        END
    END
    RETURN(None)
END

DEF builtin_scroll_buffer(exe, args):
    IF len(args) != 3: RAISE("SCROLL_BUFFER expects 3 args") END
    win_h = args[0]["String"] if type(args[0])==dict and has_key(args[0],"String") else None
    dx = int(args[1]) if type(args[1]) in (int, float) else 0
    dy = int(args[2]) if type(args[2]) in (int, float) else 0
    back = get_back_buffer(exe, win_h)
    IF back == None: RAISE("SCROLL_BUFFER: unknown window handle '{}'".format(win_h)) END
    w = int(back["width"]); h = int(back["height"])
    old = back["pixels"][:]
    fill_val = exe.get("current_color", 0xFF000000)
    back["pixels"] = [fill_val for _ in range(w*h)]
    FOR y IN range(h):
        FOR x IN range(w):
            sx = x - dx
            sy = y - dy
            IF sx >= 0 and sy >= 0 and sx < w and sy < h:
                back["pixels"][y*w + x] = old[sy*w + sx]
            END
        END
    END
    RETURN(None)
END

DEF builtin_tint_buffer(exe, args):
    IF len(args) != 5: RAISE("TINT_BUFFER expects 5 args") END
    win_h = args[0]["String"] if type(args[0])==dict and has_key(args[0],"String") else None
    tr = float(args[1]) if type(args[1]) in (int, float) else 1.0
    tg = float(args[2]) if type(args[2]) in (int, float) else 1.0
    tb = float(args[3]) if type(args[3]) in (int, float) else 1.0
    alpha = max(0.0, min(1.0, float(args[4])))
    back = get_back_buffer(exe, win_h)
    IF back == None: RAISE("TINT_BUFFER: unknown window handle '{}'".format(win_h)) END
    FOR i IN range(len(back["pixels"])):
        px = back["pixels"][i]
        br = (px >> 16) & 0xFF
        bg = (px >> 8) & 0xFF
        bb = px & 0xFF
        nr = int(round((br * (tr/255.0)) * alpha + br * (1.0 - alpha)))
        ng = int(round((bg * (tg/255.0)) * alpha + bg * (1.0 - alpha)))
        nb = int(round((bb * (tb/255.0)) * alpha + bb * (1.0 - alpha)))
        back["pixels"][i] = 0xFF000000 | (nr << 16) | (ng << 8) | nb
    END
    RETURN(None)
END

DEF builtin_canvas_draw_line(exe, args):
    IF len(args) < 5: RAISE("canvas_draw_line expects at least 5 args") END
    handle = args[0]["String"] if type(args[0])==dict and has_key(args[0],"String") else None
    x0 = int(args[1]); y0 = int(args[2]); x1 = int(args[3]); y1 = int(args[4])
    color = int(args[5]) if len(args) >= 6 and (type(args[5]) in (int, float)) else exe.get("current_color", 0xFF000000)
    canvas = get_canvas_for_draw(exe, handle)
    IF canvas == None: RAISE("canvas_draw_line: unknown handle '{}'".format(handle)) END
    draw_line_on_canvas(canvas, x0, y0, x1, y1, color)
    RETURN(None)
END

DEF builtin_canvas_draw_circle(exe, args):
    IF len(args) < 4: RAISE("canvas_draw_circle expects at least 4 args") END
    handle = args[0]["String"] if type(args[0])==dict and has_key(args[0],"String") else None
    cx = int(args[1]); cy = int(args[2]); r = int(args[3])
    color = int(args[4]) if len(args) >= 5 and (type(args[4]) in (int, float)) else exe.get("current_color", 0xFF000000)
    canvas = get_canvas_for_draw(exe, handle)
    IF canvas == None: RAISE("canvas_draw_circle: unknown handle '{}'".format(handle)) END
    draw_circle_on_canvas(canvas, cx, cy, r, color)
    RETURN(None)
END

DEF builtin_canvas_fill_circle(exe, args):
    IF len(args) < 4: RAISE("canvas_fill_circle expects at least 4 args") END
    handle = args[0]["String"] if type(args[0])==dict and has_key(args[0],"String") else None
    cx = int(args[1]); cy = int(args[2]); r = int(args[3])
    color = int(args[4]) if len(args) >= 5 and (type(args[4]) in (int, float)) else exe.get("current_color", 0xFF000000)
    canvas = get_canvas_for_draw(exe, handle)
    IF canvas == None: RAISE("canvas_fill_circle: unknown handle '{}'".format(handle)) END
    fill_circle_on_canvas(canvas, cx, cy, r, color)
    RETURN(None)
END

DEF builtin_canvas_draw_triangle(exe,args):
    IF len(args) < 7: RAISE("canvas_draw_triangle expects at least 7 args") END
    handle = args[0]["String"] if type(args[0])==dict and has_key(args[0],"String") else None
    x0=int(args[1]);y0=int(args[2]);x1=int(args[3]);y1=int(args[4]);x2=int(args[5]);y2=int(args[6])
    color = int(args[7]) if len(args) >= 8 and (type(args[7]) in (int, float)) else exe.get("current_color", 0xFF000000)
    canvas = get_canvas_for_draw(exe, handle)
    IF canvas == None: RAISE("canvas_draw_triangle: unknown handle '{}'".format(handle)) END
    draw_triangle_on_canvas(canvas, x0,y0,x1,y1,x2,y2,color)
    RETURN(None)
END

DEF builtin_canvas_fill_triangle(exe,args):
    IF len(args) < 7: RAISE("canvas_fill_triangle expects at least 7 args") END
    handle = args[0]["String"] if type(args[0])==dict and has_key(args[0],"String") else None
    x0=int(args[1]);y0=int(args[2]);x1=int(args[3]);y1=int(args[4]);x2=int(args[5]);y2=int(args[6])
    color = int(args[7]) if len(args) >= 8 and (type(args[7]) in (int, float)) else exe.get("current_color", 0xFF000000)
    canvas = get_canvas_for_draw(exe, handle)
    IF canvas == None: RAISE("canvas_fill_triangle: unknown handle '{}'".format(handle)) END
    fill_triangle_on_canvas(canvas, x0,y0,x1,y1,x2,y2,color)
    RETURN(None)
END

DEF register_graphics_api(exe):
    register_builtin(exe, "blend_to_buffer", builtin_blend_to_buffer)
    register_builtin(exe, "scroll_buffer", builtin_scroll_buffer)
    register_builtin(exe, "tint_buffer", builtin_tint_buffer)
    register_builtin(exe, "canvas_draw_line", builtin_canvas_draw_line)
    register_builtin(exe, "canvas_draw_circle", builtin_canvas_draw_circle)
    register_builtin(exe, "canvas_fill_circle", builtin_canvas_fill_circle)
    register_builtin(exe, "canvas_draw_triangle", builtin_canvas_draw_triangle)
    register_builtin(exe, "canvas_fill_triangle", builtin_canvas_fill_triangle)
    register_builtin(exe, "canvas_draw_arc", builtin_canvas_draw_arc)
    register_builtin(exe, "gfx_memory_usage", builtin_gfx_memory_usage)
    register_builtin(exe, "graphics_cleanup", builtin_graphics_cleanup)
    register_builtin(exe, "window_poll", builtin_window_poll)
    register_builtin(exe, "window_is_open", builtin_window_is_open)
    register_builtin(exe, "window_close", builtin_window_close)
    register_builtin(exe, "window_key", builtin_window_key)
    register_builtin(exe, "window_open", builtin_window_open)
    register_builtin(exe, "close", builtin_close)
    RETURN(None)
END

# Additional graphics builtins
DEF builtin_canvas_draw_arc(exe, args):
    IF len(args) < 6: RAISE("canvas_draw_arc expects at least 6 args") END
    handle = args[0]["String"] if type(args[0])==dict and has_key(args[0],"String") else None
    cx = int(args[1]); cy = int(args[2]); r = int(args[3])
    s_deg = float(args[4]); e_deg = float(args[5])
    color = int(args[6]) if len(args) >= 7 and (type(args[6]) in (int, float)) else exe.get("current_color", 0xFF000000)
    canvas = get_canvas_for_draw(exe, handle)
    IF canvas == None: RAISE("canvas_draw_arc: unknown handle '{}'".format(handle)) END
    import_math = True
    # step 1 degree increments
    step = 1.0
    if e_deg < s_deg:
        e_deg = e_deg + 360.0
    END
    prev_x = None
    prev_y = None
    deg = s_deg
    WHILE deg <= e_deg:
        rad = deg * 3.141592653589793 / 180.0
        m = __import__("math")
        x = int(round(cx + r * m.cos(rad)))
        y = int(round(cy + r * m.sin(rad)))
        IF prev_x != None:
            draw_line_on_canvas(canvas, prev_x, prev_y, x, y, color)
        END
        prev_x = x; prev_y = y
        deg = deg + step
    END
    RETURN(None)
END

DEF builtin_gfx_memory_usage(exe, args):
    IF len(args) != 1: RAISE("gfx_memory_usage expects 1 arg") END
    h = args[0]["String"] if type(args[0])==dict and has_key(args[0],"String") else None
    c = get_canvas_for_draw(exe, h)
    IF c == None: RAISE("gfx_memory_usage: unknown handle '{}'".format(h)) END
    RETURN(float(int(c["width"]) * int(c["height"]) * 4))
END

DEF builtin_graphics_cleanup(exe, args):
    exe["gfx_handles"] = {}
    exe["canvases"] = {}
    exe["back_buffers"] = {}
    exe["grid_configs"] = {}
    exe["draw_target"] = None
    RETURN(None)
END

DEF builtin_window_poll(exe, args):
    IF len(args) != 1: RAISE("window_poll expects 1 arg") END
    h = args[0]["String"] if type(args[0])==dict and has_key(args[0],"String") else None
    entry = exe["gfx_handles"].get(h, None)
    IF entry != None:
        is_open = entry[2] if type(entry) in (list, tuple) and len(entry) > 2 else False
        RETURN(bool(is_open))
    END
    RETURN(False)
END

DEF builtin_window_is_open(exe, args):
    RETURN(builtin_window_poll(exe, args))
END

DEF builtin_window_close(exe, args):
    IF len(args) != 1: RAISE("window_close expects 1 arg") END
    h = args[0]["String"] if type(args[0])==dict and has_key(args[0],"String") else None
    IF h == None: RAISE("window_close: expected string handle") END
    IF has_key(exe["gfx_handles"], h):
        entry = exe["gfx_handles"][h]
        IF type(entry) in (list, tuple) and len(entry) > 2:
            entry[2] = False
        END
    END
    exe["canvases"].pop(h, None)
    exe["back_buffers"].pop(h, None)
    exe["grid_configs"].pop(h, None)
    IF exe.get("draw_target", None) == h:
        exe["draw_target"] = None
    END
    RETURN(None)
END

DEF builtin_window_key(exe, args):
    IF len(args) != 1: RAISE("window_key expects 1 arg") END
    # No X11 backend here; return empty string
    RETURN("")
END

DEF builtin_window_open(exe, args):
    IF len(args) != 1: RAISE("window_open expects 1 arg") END
    h = args[0]["String"] if type(args[0])==dict and has_key(args[0],"String") else None
    IF h == None: RAISE("WINDOW_OPEN: expected string handle") END
    entry = exe["gfx_handles"].get(h, None)
    IF entry != None:
        is_open = entry[2] if type(entry) in (list, tuple) and len(entry) > 2 else False
        RETURN(bool(is_open))
    END
    RETURN(False)
END

DEF builtin_close(exe, args):
    IF len(args) != 1: RAISE("CLOSE expects 1 arg (handle)") END
    h = args[0]["String"] if type(args[0])==dict and has_key(args[0],"String") else None
    IF h == None: RAISE("CLOSE: expected string handle") END
    IF has_key(exe["open_files"], h):
        of = exe["open_files"].pop(h, None)
        # If writer or appender, try flush (best-effort)
        # We can't flush arbitrary handles here; ignore
        RETURN(None)
    END
    # Otherwise behave like window_close
    RETURN(builtin_window_close(exe, args))
END

# FPS registration and builtins
DEF register_fps_api(exe):
    register_builtin(exe, "fps_init", builtin_fps_init)
    register_builtin(exe, "fps_begin", builtin_fps_begin)
    register_builtin(exe, "fps_end", builtin_fps_end)
    register_builtin(exe, "fps_tick", builtin_fps_tick)
    register_builtin(exe, "fps_sleep", builtin_fps_sleep)
    register_builtin(exe, "fps_delta", builtin_fps_delta)
    register_builtin(exe, "fps_get", builtin_fps_get)
    register_builtin(exe, "fps_target", builtin_fps_target)
    register_builtin(exe, "fps_set_target", builtin_fps_set_target)
    register_builtin(exe, "fps_frame_count", builtin_fps_frame_count)
    RETURN(None)
END

DEF builtin_fps_init(exe, args):
    t = float(args[0]) if len(args) >= 1 and (type(args[0]) in (int, float)) else 60.0
    exe["fps_state"] = FpsState_new(t)
    RETURN(None)
END

DEF builtin_fps_begin(exe, args):
    t = float(args[0]) if len(args) >= 1 and (type(args[0]) in (int, float)) else 60.0
    IF exe.get("fps_state", None) == None:
        exe["fps_state"] = FpsState_new(t)
    ELSE:
        s = exe["fps_state"]
        s["target_fps"] = t
        s["fixed_delta"] = 1.0 / t
    END
    s = exe.get("fps_state")
    IF s != None:
        s["frame_start"] = time_instant_now()
    END
    RETURN(None)
END

DEF builtin_fps_end(exe, args):
    s = exe.get("fps_state")
    IF s != None:
        IF NOT s.get("paused", False):
            work_elapsed = time_instant_now() - s.get("frame_start", time_instant_now())
            s["last_frame_time_ms"] = work_elapsed * 1000.0
            target_dur = s.get("fixed_delta", 1.0/60.0)
            IF work_elapsed < target_dur:
                time_sleep(target_dur - work_elapsed)
            END
            total = time_instant_now() - s.get("frame_start", time_instant_now())
            secs = total
            ft = s.get("frame_times", [])
            ft.append(secs)
            IF len(ft) > 256:
                ft.pop(0)
            END
            s["frame_times"] = ft
        END
    END
    RETURN(None)
END

DEF builtin_fps_tick(exe, args):
    s = exe.get("fps_state")
    IF s != None:
        IF NOT s.get("paused", False):
            s["frame_count"] = s.get("frame_count",0) + 1
        END
        RETURN(float(s.get("fixed_delta", 1.0/60.0)))
    END
    RETURN(float(1.0/60.0))
END

DEF builtin_fps_sleep(exe, args):
    s = exe.get("fps_state")
    IF s != None and NOT s.get("paused", False):
        elapsed = time_instant_now() - s.get("frame_start", time_instant_now())
        target = s.get("fixed_delta", 1.0/60.0)
        IF elapsed < target:
            time_sleep(target - elapsed)
        END
    END
    RETURN(None)
END

DEF builtin_fps_delta(exe, args):
    d = exe.get("fps_state", {}).get("fixed_delta", 1.0/60.0)
    RETURN(float(d))
END

DEF builtin_fps_get(exe, args):
    s = exe.get("fps_state")
    IF s != None:
        if s.get("last_frame_time_ms",0.0) > 0.0:
            RETURN(1000.0 / s.get("last_frame_time_ms"))
        END
        RETURN(float(s.get("target_fps", 60.0)))
    END
    RETURN(float(0.0))
END

DEF builtin_fps_target(exe, args):
    RETURN(float(exe.get("fps_state", {}).get("target_fps", 60.0)))
END

DEF builtin_fps_set_target(exe, args):
    IF len(args) < 1: RAISE("fps_set_target expects a positive number") END
    target = float(args[0])
    IF target <= 0.0: RAISE("fps_set_target expects a positive number") END
    s = exe.get("fps_state")
    IF s != None:
        s["target_fps"] = target
        s["fixed_delta"] = 1.0 / target
    ELSE:
        exe["fps_state"] = FpsState_new(target)
    END
    RETURN(None)
END

DEF builtin_fps_frame_count(exe, args):
    RETURN(float(exe.get("fps_state", {}).get("frame_count", 0)))
END

# Additional FPS helpers
DEF builtin_fps_avg(exe, args):
    n = int(args[0]) if len(args) >= 1 and (type(args[0]) in (int, float)) else 10
    s = exe.get("fps_state", None)
    IF s == None: RETURN(float(0.0)) END
    ft = s.get("frame_times", [])
    IF len(ft) == 0:
        RETURN(float(s.get("target_fps", 60.0)))
    END
    take = min(n, len(ft))
    sum_secs = 0.0
    FOR i IN range(1, take+1):
        sum_secs = sum_secs + ft[-i]
    END
    avg_secs = sum_secs / float(take)
    IF avg_secs > 0.0:
        RETURN(1.0 / avg_secs)
    ELSE:
        RETURN(float(s.get("target_fps", 60.0)))
    END
END

DEF builtin_fps_paused(exe, args):
    RETURN(bool(exe.get("fps_state", {}).get("paused", False)))
END

DEF builtin_fps_pause(exe, args):
    s = exe.get("fps_state", None)
    IF s != None and not s.get("paused", False):
        s["paused"] = True
        s["pause_start"] = time_instant_now()
    END
    RETURN(None)
END

DEF builtin_fps_resume(exe, args):
    s = exe.get("fps_state", None)
    IF s != None and s.get("paused", False):
        ps = s.pop("pause_start", None)
        IF ps != None:
            s["paused_duration"] = s.get("paused_duration", 0.0) + (time_instant_now() - ps)
        END
        s["paused"] = False
    END
    RETURN(None)
END

DEF builtin_fps_elapsed(exe, args):
    s = exe.get("fps_state", None)
    IF s == None: RETURN(float(0.0)) END
    total = time_instant_now() - s.get("init_time", time_instant_now())
    paused = s.get("paused_duration", 0.0)
    IF s.get("paused", False):
        ps = s.get("pause_start", None)
        IF ps != None:
            paused = paused + (time_instant_now() - ps)
        END
    END
    active = max(0.0, total - paused)
    RETURN(float(active))
END

DEF builtin_fps_frame_time(exe, args):
    RETURN(float(exe.get("fps_state", {}).get("last_frame_time_ms", 0.0)))
END

DEF builtin_fps_behind(exe, args):
    s = exe.get("fps_state", None)
    IF s == None: RETURN(False) END
    budget_ms = 1000.0 / s.get("target_fps", 60.0)
    RETURN(bool(s.get("last_frame_time_ms", 0.0) > budget_ms))
END

# stdin readline
DEF builtin_stdin_readline(exe, args):
    # stdin reading requires a host binding to be useful in pure-Pasta.
    # TODO: implement a pure-Pasta stdin reader or provide a host-provided binding.
    RETURN(None)
END

# sys.* helpers
DEF builtin_sys_env(exe, args):
    IF len(args) != 1: RAISE("sys.env expects 1 arg (name)") END
    key = args[0]
    IF type(key) == dict and has_key(key, "String"):
        RETURN(getenv(key["String"]) or "")
    END
    RAISE("sys.env: argument must be a string")
END

DEF builtin_sys_exit(exe, args):
    code = int(args[0]) if len(args) >= 1 and (type(args[0]) in (int, float)) else 0
    exit_process(code)
    RETURN(None)
END

DEF builtin_sys_args(exe, args):
    # argv_get() is a placeholder that should return the program argv list
    lst = argv_get() if callable(argv_get) else []
    out = []
    FOR a IN lst:
        out.append({"String": a})
    END
    RETURN(out)
END

DEF builtin_sys_platform(exe, args):
    p = getenv("OS_NAME")
    IF p != None: RETURN(p) END
    RETURN("linux")
END

DEF builtin_sys_sleep(exe, args):
    IF len(args) != 1: RAISE("sys.sleep expects 1 arg (ms)") END
    ms = int(args[0]) if type(args[0]) in (int, float) else 0
    time_sleep(ms / 1000.0)
    RETURN(None)
END

DEF builtin_sys_getcwd(exe, args):
    RETURN(fs_cwd())
END

# time.* helpers
DEF builtin_time_now(exe, args):
    RETURN(float(time_now_ms()))
END

DEF builtin_time_now_ns(exe, args):
    RETURN(float(time_now_ns()))
END

DEF builtin_time_sleep(exe, args):
    IF len(args) != 1: RAISE("time.sleep expects 1 arg (ms)") END
    ms = int(args[0]) if type(args[0]) in (int, float) else 0
    time_sleep(ms / 1000.0)
    RETURN(None)
END

DEF builtin_time_format(exe, args):
    IF len(args) != 1: RAISE("time.format expects 1 arg (epoch_ms)") END
    ms = args[0] if type(args[0]) in (int, float) else 0
    RETURN("epoch+{}s".format(int(ms / 1000)))
END

# rand.* helpers
DEF builtin_rand_int(exe, args):
    RETURN(float(int(time_now_ns()) % 0x7fff))
END

DEF builtin_rand_float(exe, args):
    RETURN(float((time_now_ns() % 1000000) / 1000000.0))
END

