# --- String builtin implementations translated from executor.rs ---
# --- Additional translated builtins from executor.rs slice ---

# JSON stringify (supports pretty flag)
DEF builtin_json_stringify(exe, args):
    IF len(args) < 1 or len(args) > 2: RAISE("JSON_STRINGIFY expects 1 or 2 arguments: value [, pretty]") END
    pretty = False
    IF len(args) >= 2:
        pretty = bool(args[1])
    END
    TRY:
        json = __import__("json")
        IF pretty:
            s = json.dumps(args[0], indent=2)
        ELSE:
            s = json.dumps(args[0])
        END
        RETURN({"String": s})
    EXCEPT AS e:
        RAISE("JSON_STRINGIFY: {}".format(str(e)))
    END
END

# Tensor helpers (simple Pasta representation)
DEF builtin_tensor_create_zeros(exe, args):
    IF len(args) != 2: RAISE("tensor_create_zeros expects 2 arguments (rows, cols)") END
    r = args[0]; c = args[1]
    IF NOT (type(r) in (int, float) and type(c) in (int, float)): RAISE("tensor_create_zeros: expected two numbers") END
    rows = int(round(r)); cols = int(round(c))
    data = []
    FOR i IN range(rows*cols): data.append(0.0) END
    RETURN({"Tensor": {"shape": [rows, cols], "dtype": "float32", "data": data}})
END

DEF builtin_tensor_create_ones(exe, args):
    IF len(args) != 2: RAISE("tensor_create_ones expects 2 arguments (rows, cols)") END
    r = args[0]; c = args[1]
    IF NOT (type(r) in (int, float) and type(c) in (int, float)): RAISE("tensor_create_ones: expected two numbers") END
    rows = int(round(r)); cols = int(round(c))
    data = []
    FOR i IN range(rows*cols): data.append(1.0) END
    RETURN({"Tensor": {"shape": [rows, cols], "dtype": "float32", "data": data}})
END

DEF builtin_tensor_create_identity(exe, args):
    IF len(args) != 1: RAISE("tensor_create_identity expects 1 argument (n)") END
    n_v = args[0]
    IF NOT (type(n_v) in (int, float)): RAISE("tensor_create_identity: expected number") END
    n = int(round(n_v))
    data = []
    FOR i IN range(n*n): data.append(0.0) END
    FOR i IN range(n): data[i*n + i] = 1.0 END
    RETURN({"Tensor": {"shape": [n, n], "dtype": "float32", "data": data}})
END

DEF builtin_tensor_get_shape(exe, args):
    IF len(args) != 1: RAISE("tensor_get_shape expects 1 argument") END
    t = args[0]
    IF type(t) == dict and has_key(t, "Tensor"):
        shape = t["Tensor"].get("shape", [])
        out = []
        FOR s IN shape: out.append(float(s)) END
        RETURN(out)
    END
    RAISE("tensor_get_shape: expected a tensor")
END

DEF builtin_tensor_get_dtype(exe, args):
    IF len(args) != 1: RAISE("tensor_get_dtype expects 1 argument") END
    t = args[0]
    IF type(t) == dict and has_key(t, "Tensor"):
        RETURN(t["Tensor"].get("dtype", "float32"))
    END
    RAISE("tensor_get_dtype: expected a tensor")
END

DEF builtin_tensor_sum_all(exe, args):
    IF len(args) != 1: RAISE("tensor_sum_all expects 1 argument") END
    t = args[0]
    IF type(t) == dict and has_key(t, "Tensor"):
        data = t["Tensor"].get("data", [])
        s = 0.0
        FOR v IN data: s = s + float(v) END
        RETURN(float(s))
    END
    RAISE("tensor_sum_all: expected a tensor")
END

DEF builtin_tensor_mean_all(exe, args):
    IF len(args) != 1: RAISE("tensor_mean_all expects 1 argument") END
    t = args[0]
    IF type(t) == dict and has_key(t, "Tensor"):
        data = t["Tensor"].get("data", [])
        n = len(data)
        IF n == 0: RETURN(float(0.0)) END
        s = 0.0
        FOR v IN data: s = s + float(v) END
        RETURN(float(s / float(n)))
    END
    RAISE("tensor_mean_all: expected a tensor")
END

# Logging and error helpers
DEF builtin_log_info(exe, args):
    IF len(args) != 1: RAISE("log_info expects 1 argument") END
    print("[INFO] {}".format(Executor_value_to_string(exe, args[0])))
    RETURN(None)
END

DEF builtin_log_warning(exe, args):
    IF len(args) != 1: RAISE("log_warning expects 1 argument") END
    print("[WARN] {}".format(Executor_value_to_string(exe, args[0])))
    RETURN(None)
END

DEF builtin_error(exe, args):
    msg = "error"
    IF len(args) >= 1:
        msg = Executor_value_to_string(exe, args[0])
    END
    RAISE(msg)
END

DEF builtin_log_error(exe, args):
    IF len(args) != 1: RAISE("log_error expects 1 argument") END
    print("[ERROR] {}".format(Executor_value_to_string(exe, args[0])))
    RETURN(None)
END

DEF builtin_log_debug(exe, args):
    IF len(args) != 1: RAISE("log_debug expects 1 argument") END
    print("[DEBUG] {}".format(Executor_value_to_string(exe, args[0])))
    RETURN(None)
END

DEF builtin_debug_print_type(exe, args):
    IF len(args) != 1: RAISE("debug_print_type expects 1 argument") END
    a = args[0]
    t = "unknown"
    IF type(a) in (int, float): t = "number"
    ELIF type(a) == dict and has_key(a, "String"): t = "string"
    ELIF type(a) == dict and has_key(a, "Tensor"): t = "tensor"
    ELIF type(a) == dict and has_key(a, "Builtin"): t = "builtin"
    ELIF type(a) == list: t = "list"
    ELIF a == None: t = "none"
    END
    print("[DEBUG] type({}) = {}".format(Executor_value_to_string(exe, a), t))
    RETURN(None)
END

DEF builtin_debug_print_length(exe, args):
    IF len(args) != 1: RAISE("debug_print_length expects 1 argument") END
    a = args[0]
    l = 0
    IF type(a) == dict and has_key(a, "String"):
        l = len(list(a["String"]))
    ELIF type(a) == list:
        l = len(a)
    ELIF type(a) == dict and has_key(a, "Dict"):
        l = len(list(a["Dict"].keys()))
    END
    print("[DEBUG] len({}) = {}".format(Executor_value_to_string(exe, a), l))
    RETURN(float(l))
END

DEF builtin_read_all(exe, args):
    IF len(args) != 1: RAISE("READ_ALL expects 1 argument: file handle") END
    h = args[0]
    IF NOT (type(h) == dict and has_key(h, "String")): RAISE("READ_ALL: handle must be a string") END
    hid = h["String"]
    ent = exe["open_files"].get(hid, None)
    IF ent == None: RAISE("READ_ALL: unknown handle \"{}\"".format(hid)) END
    s = fs_read_to_string(ent["path"]) or ""
    RETURN({"String": s})
END

DEF builtin_dict(exe, args):
    IF len(args) % 2 != 0: RAISE("DICT expects an even number of arguments (key, value pairs)") END
    m = {}
    i = 0
    WHILE i < len(args):
        k = Executor_value_to_string(exe, args[i])
        v = args[i+1]
        m[k] = v
        i = i + 2
    END
    RETURN({"Dict": m})
END

DEF _unwrap_dict_map(exe, d):
    # helper: accept {'Dict': map} or raw dict-like map
    IF type(d) == dict and has_key(d, "Dict"):
        RETURN(d["Dict"])
    ELIF type(d) == dict and NOT has_key(d, "String") and NOT has_key(d, "Heap"):
        # assume it's a plain map
        RETURN(d)
    END
    RAISE("expected a dict-like value")
END

DEF builtin_dict_get(exe, args):
    IF len(args) != 2: RAISE("dict_get expects 2 arguments: dict, key") END
    key = Executor_value_to_string(exe, args[1])
    d = args[0]
    m = _unwrap_dict_map(exe, d)
    IF has_key(m, key): RETURN(m[key]) END
    RAISE("dict_get: key \"{}\" not found".format(key))
END

DEF builtin_dict_has(exe, args):
    IF len(args) != 2: RAISE("dict_has expects 2 arguments: dict, key") END
    key = Executor_value_to_string(exe, args[1])
    d = args[0]
    m = _unwrap_dict_map(exe, d)
    RETURN(bool(has_key(m, key)))
END

DEF builtin_dict_keys(exe, args):
    IF len(args) != 1: RAISE("dict_keys expects 1 argument: dict") END
    d = args[0]
    m = _unwrap_dict_map(exe, d)
    keys = list(m.keys())
    keys.sort()
    out = []
    FOR k IN keys: out.append({"String": k}) END
    RETURN(out)
END

DEF builtin_dict_values(exe, args):
    IF len(args) != 1: RAISE("dict_values expects 1 argument: dict") END
    d = args[0]
    m = _unwrap_dict_map(exe, d)
    vals = []
    FOR k IN sorted(list(m.keys())):
        vals.append(m[k])
    END
    RETURN(vals)
END

DEF builtin_dict_items(exe, args):
    IF len(args) != 1: RAISE("dict_items expects 1 argument: dict") END
    d = args[0]
    m = _unwrap_dict_map(exe, d)
    items = []
    FOR k IN sorted(list(m.keys())):
        items.append([{"String": k}, m[k]])
    END
    RETURN(items)
END

DEF builtin_dict_len(exe, args):
    IF len(args) != 1: RAISE("dict_len expects 1 argument: dict") END
    d = args[0]
    m = _unwrap_dict_map(exe, d)
    RETURN(float(len(list(m.keys()))))
END

