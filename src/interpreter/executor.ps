DEF builtin_list_sort(exe, args):
    IF len(args) != 1: RAISE("list_sort expects 1 argument") END
    a = args[0]
    IF type(a) == list:
        def keyfn(x):
            IF type(x) in (int, float): RETURN((0, float(x))) END
            RETURN((1, Executor_value_to_string(exe, x)))
        END
        out = sorted(a, key=keyfn)
        RETURN(out)
    END
    RAISE("list_sort: expected a list")
END

DEF builtin_list_min(exe, args):
    IF len(args) != 1: RAISE("list_min expects 1 argument") END
    a = args[0]
    IF type(a) == list:
        nums = []
        FOR v IN a:
            IF type(v) in (int, float): nums.append(float(v)) END
        END
        IF len(nums) == 0: RAISE("list_min: empty list") END
        m = min(nums)
        RETURN(float(m))
    END
    RAISE("list_min: expected a list")
END

DEF builtin_list_max(exe, args):
    IF len(args) != 1: RAISE("list_max expects 1 argument") END
    a = args[0]
    IF type(a) == list:
        nums = []
        FOR v IN a:
            IF type(v) in (int, float): nums.append(float(v)) END
        END
        IF len(nums) == 0: RAISE("list_max: empty list") END
        m = max(nums)
        RETURN(float(m))
    END
    RAISE("list_max: expected a list")
END

DEF builtin_list_avg(exe, args):
    IF len(args) != 1: RAISE("list_avg expects 1 argument") END
    a = args[0]
    IF type(a) == list:
        nums = []
        FOR v IN a:
            IF type(v) in (int, float): nums.append(float(v)) END
        END
        IF len(nums) == 0: RAISE("list_avg: no numeric elements") END
        s = sum(nums)
        RETURN(float(s / len(nums)))
    END
    RAISE("list_avg: expected a list")
END

DEF builtin_list_contains(exe, args):
    IF len(args) != 2: RAISE("list_contains expects 2 arguments (list, value)") END
    a = args[0]
    IF type(a) == list:
        found = False
        FOR v IN a:
            IF v == args[1]: found = True ; BREAK END
        END
        RETURN(bool(found))
    END
    RAISE("list_contains: first argument must be a list")
END

DEF builtin_list_take(exe, args):
    IF len(args) != 2: RAISE("list_take expects 2 arguments (list, count)") END
    n_arg = args[1]
    IF type(n_arg) in (int, float): n = int(round(n_arg)) ELSE: RAISE("list_take: count must be a number") END
    a = args[0]
    IF type(a) == list: RETURN(a[:n]) END
    RAISE("list_take: expected a list")
END

DEF builtin_list_drop(exe, args):
    IF len(args) != 2: RAISE("list_drop expects 2 arguments (list, count)") END
    n_arg = args[1]
    IF type(n_arg) in (int, float): n = int(round(n_arg)) ELSE: RAISE("list_drop: count must be a number") END
    a = args[0]
    IF type(a) == list: RETURN(a[n:]) END
    RAISE("list_drop: expected a list")
END

DEF builtin_list_slice(exe, args):
    IF len(args) != 3: RAISE("list_slice expects 3 arguments (list, start, end)") END
    start_arg = args[1]
    end_arg = args[2]
    IF type(start_arg) in (int, float): start = int(round(start_arg)) ELSE: RAISE("list_slice: start must be a number") END
    IF type(end_arg) in (int, float): end = int(round(end_arg)) ELSE: RAISE("list_slice: end must be a number") END
    a = args[0]
    IF type(a) == list:
        e = min(end, len(a))
        s = min(start, e)
        RETURN(a[s:e])
    END
    RAISE("list_slice: expected a list")
END

DEF builtin_list_concat(exe, args):
    IF len(args) != 2: RAISE("list_concat expects 2 arguments") END
    a = args[0]; b = args[1]
    IF type(a) == list and type(b) == list:
        out = a[:] ; out.extend(b) ; RETURN(out)
    END
    RAISE("list_concat: both arguments must be lists")
END

DEF builtin_list_flatten(exe, args):
    IF len(args) != 1: RAISE("list_flatten expects 1 argument") END
    a = args[0]
    IF type(a) == list:
        out = []
        FOR v IN a:
            IF type(v) == list: out.extend(v) ELSE: out.append(v) END
        END
        RETURN(out)
    END
    RAISE("list_flatten: expected a list")
END

# validation/collection/list extras (translated from executor.rs)
DEF builtin_list_sum(exe, args):
    IF len(args) != 1: RAISE("list_sum expects 1 argument") END
    a = args[0]
    IF type(a) == list:
        s = 0.0
        FOR v IN a:
            IF type(v) in (int, float): s = s + float(v)
            ELIF type(v) == dict and has_key(v, "Bool"): s = s + (1.0 if v["Bool"] else 0.0)
            ELIF type(v) == bool: s = s + (1.0 if v else 0.0)
            END
        END
        RETURN(float(s))
    END
    RAISE("list_sum: expected a list")
END

DEF builtin_list_average(exe, args):
    IF len(args) != 1: RAISE("list_average expects 1 argument") END
    a = args[0]
    IF type(a) == list:
        IF len(a) == 0: RETURN(float(0)) END
        total = 0.0
        count = 0
        FOR v IN a:
            IF type(v) in (int, float): total = total + float(v); count = count + 1
            ELSE: RAISE("list_average: all elements must be numbers") END
        END
        IF count == 0: RAISE("list_average: no numeric elements") END
        RETURN(float(total / count))
    END
    RAISE("list_average: expected a list")
END

DEF builtin_not_null(exe, args):
    IF len(args) != 1: RAISE("not_null expects 1 argument") END
    RETURN(bool(args[0] != None))
END

DEF builtin_identity(exe, args):
    IF len(args) != 1: RAISE("identity expects 1 argument") END
    RETURN(args[0])
END

DEF builtin_bool(exe, args):
    IF len(args) != 1: RAISE("bool() takes exactly one argument") END
    a = args[0]
    IF a == None: RETURN(False) END
    IF type(a) == dict and has_key(a, "Bool"): RETURN(bool(a["Bool"])) END
    IF type(a) in (int, float): RETURN(bool(a != 0)) END
    IF type(a) == dict and has_key(a, "String"): RETURN(bool(len(list(a["String"])))) END
    IF type(a) == str: RETURN(bool(len(a))) END
    IF type(a) == list: RETURN(bool(len(a))) END
    RETURN(True)
END

DEF builtin_validate_not_empty(exe, args):
    IF len(args) != 2: RAISE("validate_not_empty expects 2 arguments (value, name)") END
    v = args[0]
    is_empty = False
    IF v == None: is_empty = True
    ELIF type(v) == list and len(v) == 0: is_empty = True
    ELIF type(v) == dict and has_key(v, "String") and len(list(v["String"])) == 0: is_empty = True
    END
    RETURN(bool(not is_empty))
END

DEF builtin_validate_is_number(exe, args):
    IF len(args) != 2: RAISE("validate_is_number expects 2 arguments") END
    v = args[0]
    RETURN(bool(type(v) in (int, float)))
END

DEF builtin_validate_is_string(exe, args):
    IF len(args) != 2: RAISE("validate_is_string expects 2 arguments") END
    v = args[0]
    RETURN(bool(type(v) == dict and has_key(v, "String")))
END

DEF builtin_validate_range(exe, args):
    IF len(args) != 4: RAISE("validate_range expects 4 arguments (value, min, max, name)") END
    v = args[0]; lo = args[1]; hi = args[2]
    IF type(v) in (int, float) and type(lo) in (int, float) and type(hi) in (int, float):
        RETURN(bool(v >= lo and v <= hi))
    END
    RAISE("validate_range: first 3 arguments must be numbers")
END

DEF builtin_validate_length(exe, args):
    IF len(args) != 4: RAISE("validate_length expects 4 arguments") END
    v = args[0]
    IF type(v) == list: actual = float(len(v))
    ELIF type(v) == dict and has_key(v, "String"): actual = float(len(list(v["String"])))
    ELSE: RAISE("validate_length: first argument must be list or string") END
    lo = args[1]; hi = args[2]
    IF type(lo) in (int, float) and type(hi) in (int, float):
        RETURN(bool(actual >= lo and actual <= hi))
    END
    RAISE("validate_length: min_len and max_len must be numbers")
END

# Collection helpers
DEF builtin_collection_empty(exe, args):
    RETURN([])
END

DEF builtin_collection_single(exe, args):
    IF len(args) != 1: RAISE("collection_single expects 1 argument") END
    RETURN([args[0]])
END

DEF builtin_collection_pair(exe, args):
    IF len(args) != 2: RAISE("collection_pair expects 2 arguments") END
    RETURN([args[0], args[1]])
END

DEF builtin_collection_triple(exe, args):
    IF len(args) != 3: RAISE("collection_triple expects 3 arguments") END
    RETURN([args[0], args[1], args[2]])
END

DEF builtin_collection_fill(exe, args):
    IF len(args) != 2: RAISE("collection_fill expects 2 arguments (value, size)") END
    n_arg = args[1]
    IF type(n_arg) in (int, float): n = int(round(n_arg)) ELSE: RAISE("collection_fill: size must be a number") END
    out = []
    FOR i IN range(n): out.append(args[0]) END
    RETURN(out)
END

DEF builtin_collection_merge(exe, args):
    IF len(args) != 2: RAISE("collection_merge expects 2 arguments") END
    a = args[0]; b = args[1]
    IF type(a) == list and type(b) == list:
        out = a[:] ; out.extend(b) ; RETURN(out)
    END
    RAISE("collection_merge: both arguments must be lists")
END

DEF builtin_collection_merge_unique(exe, args):
    IF len(args) != 2: RAISE("collection_merge_unique expects 2 arguments") END
    a = args[0]; b = args[1]
    IF type(a) == list and type(b) == list:
        seen = set()
        out = []
        FOR v IN (a + b):
            k = Executor_value_to_string(exe, v)
            IF k not in seen:
                seen.add(k)
                out.append(v)
            END
        END
        RETURN(out)
    END
    RAISE("collection_merge_unique: both arguments must be lists")
END

DEF builtin_collection_zip(exe, args):
    IF len(args) != 2: RAISE("collection_zip expects 2 arguments") END
    a = args[0]; b = args[1]
    IF type(a) == list and type(b) == list:
        out = []
        ln = min(len(a), len(b))
        FOR i IN range(ln):
            out.append([a[i], b[i]])
        END
        RETURN(out)
    END
    RAISE("collection_zip: both arguments must be lists")
END

